{
  "specId": "recording-headless-chrome",
  "description": "Headless Chrome recording (ADR 01176): the browser engine captures the tab by title, sized to the viewport, with no display, so it runs on Windows, macOS, and Linux alike. Covers the auto engine, the explicit browser engine, a recording across a goTo navigation, a cursor restored from a position outside the viewport, headed Chrome, and headless Firefox, which stays SKIPPED. Chrome's tab-sharing bar would shorten the page while a tab is captured, so the runner grows the window by the bar's height (ADR 01227), and the video is the viewport's size, never tab capture's 800x600 default. Headless Chrome renders at a device pixel ratio of 1, so the viewport's CSS size is the video's pixel size; headed Chrome on a high-DPI screen records at device pixels, so its permutation asserts no size.",
  "tests": [
    {
      "testId": "headless-chrome-auto-engine",
      "description": "A record with no engine on headless Chrome records the tab with the browser engine, at the viewport's size.",
      "runOn": [
        {
          "platforms": [
            "windows",
            "mac",
            "linux"
          ],
          "browsers": {
            "name": "chrome",
            "headless": true,
            "viewport": {
              "width": 1024,
              "height": 640
            }
          }
        }
      ],
      "steps": [
        {
          "goTo": "http://localhost:8092"
        },
        {
          "record": {
            "path": "headless-chrome-auto.mp4",
            "overwrite": "true",
            "verify": {
              "minDuration": 0.5,
              "notBlack": true,
              "resolution": {
                "width": 1024,
                "height": 640
              }
            }
          }
        },
        {
          "find": {
            "selector": "body",
            "timeout": 5000
          }
        },
        {
          "wait": 1500
        },
        {
          "stopRecord": true,
          "variables": {
            "HC_AUTO_PATH": "$$recordingPath",
            "HC_AUTO_FORMAT": "$$format",
            "HC_AUTO_WIDTH": "$$width",
            "HC_AUTO_HEIGHT": "$$height"
          }
        },
        {
          "description": "Assert an MP4 at the viewport's size.",
          "runShell": "node -e \"const e=process.env; const w=Number(e.HC_AUTO_WIDTH), h=Number(e.HC_AUTO_HEIGHT); const ok = e.HC_AUTO_FORMAT === 'mp4' && require('fs').existsSync(e.HC_AUTO_PATH) && Math.abs(w-1024) <= 2 && Math.abs(h-640) <= 2; if (!ok) { console.error(JSON.stringify({w,h})); process.exit(1) }\""
        }
      ]
    },
    {
      "testId": "headless-chrome-browser-engine",
      "description": "An explicit browser engine on headless Chrome records the tab, at the viewport's size.",
      "runOn": [
        {
          "platforms": [
            "windows",
            "mac",
            "linux"
          ],
          "browsers": {
            "name": "chrome",
            "headless": true,
            "viewport": {
              "width": 1024,
              "height": 640
            }
          }
        }
      ],
      "steps": [
        {
          "goTo": "http://localhost:8092"
        },
        {
          "record": {
            "path": "headless-chrome-browser.webm",
            "engine": "browser",
            "overwrite": "true",
            "verify": {
              "minDuration": 0.5,
              "notBlack": true,
              "resolution": {
                "width": 1024,
                "height": 640
              }
            }
          }
        },
        {
          "wait": 1500
        },
        {
          "stopRecord": true,
          "variables": {
            "HC_BROWSER_FORMAT": "$$format",
            "HC_BROWSER_WIDTH": "$$width",
            "HC_BROWSER_HEIGHT": "$$height"
          }
        },
        {
          "description": "Assert a WebM at the viewport's size, even when the capture's first frames come from the tab while it's behind the recorder tab (ADR 01197).",
          "runShell": "node -e \"const e=process.env; const w=Number(e.HC_BROWSER_WIDTH), h=Number(e.HC_BROWSER_HEIGHT); const ok = e.HC_BROWSER_FORMAT === 'webm' && Math.abs(w-1024) <= 2 && Math.abs(h-640) <= 2; if (!ok) { console.error(JSON.stringify({w,h})); process.exit(1) }\""
        }
      ]
    },
    {
      "testId": "headless-chrome-viewport-held",
      "description": "An 800x600 viewport stays 800x600 while the sharing bar shows and after the recording stops, and the video is 800x600 (ADR 01227).",
      "runOn": [
        {
          "platforms": [
            "windows",
            "mac",
            "linux"
          ],
          "browsers": {
            "name": "chrome",
            "headless": true,
            "viewport": {
              "width": 800,
              "height": 600
            }
          }
        }
      ],
      "steps": [
        {
          "goTo": "http://localhost:8092"
        },
        {
          "record": {
            "path": "headless-chrome-viewport-held.webm",
            "engine": "browser",
            "overwrite": "true",
            "verify": {
              "minDuration": 0.5,
              "resolution": {
                "width": 800,
                "height": 600
              }
            }
          }
        },
        {
          "wait": 1500
        },
        {
          "screenshot": {
            "path": "headless-chrome-viewport-during.png",
            "overwrite": "true"
          },
          "variables": {
            "HC_HELD_DURING_WIDTH": "$$width",
            "HC_HELD_DURING_HEIGHT": "$$height"
          }
        },
        {
          "stopRecord": true
        },
        {
          "screenshot": {
            "path": "headless-chrome-viewport-after.png",
            "overwrite": "true"
          },
          "variables": {
            "HC_HELD_AFTER_WIDTH": "$$width",
            "HC_HELD_AFTER_HEIGHT": "$$height"
          }
        },
        {
          "description": "Assert the page was 800x600 during and after the recording.",
          "runShell": "node -e \"const e=process.env; const s=[e.HC_HELD_DURING_WIDTH, e.HC_HELD_DURING_HEIGHT, e.HC_HELD_AFTER_WIDTH, e.HC_HELD_AFTER_HEIGHT].map(Number); const ok = s[0] === 800 && s[1] === 600 && s[2] === 800 && s[3] === 600; if (!ok) { console.error(JSON.stringify(s)); process.exit(1) }\""
        }
      ]
    },
    {
      "testId": "headless-chrome-across-navigation",
      "description": "A headless Chrome recording keeps capturing the tab across a goTo navigation.",
      "runOn": [
        {
          "platforms": [
            "windows",
            "mac",
            "linux"
          ],
          "browsers": {
            "name": "chrome",
            "headless": true,
            "viewport": {
              "width": 1024,
              "height": 640
            }
          }
        }
      ],
      "steps": [
        {
          "goTo": "http://localhost:8092"
        },
        {
          "record": {
            "path": "headless-chrome-navigation.mp4",
            "overwrite": "true",
            "verify": {
              "minDuration": 2,
              "notBlack": true
            }
          }
        },
        {
          "wait": 1200
        },
        {
          "goTo": "http://localhost:8092/drag-drop-test.html"
        },
        {
          "find": {
            "selector": "body",
            "timeout": 5000
          }
        },
        {
          "wait": 1200
        },
        {
          "stopRecord": true
        }
      ]
    },
    {
      "testId": "headless-chrome-cursor-restore-out-of-viewport",
      "description": "A navigation during a recording puts the synthetic cursor back at its saved position. `find` with `moveTo` saves the position of an element 3000 px below the fold, which is outside the viewport. The restore after the goTo has to stay inside the viewport instead of crashing the context with `move target out of bounds`.",
      "runOn": [
        {
          "platforms": [
            "windows",
            "mac",
            "linux"
          ],
          "browsers": {
            "name": "chrome",
            "headless": true,
            "viewport": {
              "width": 1024,
              "height": 640
            }
          }
        }
      ],
      "steps": [
        {
          "goTo": "http://localhost:8092/find-image.html"
        },
        {
          "record": {
            "path": "headless-chrome-cursor-restore.mp4",
            "overwrite": "true"
          }
        },
        {
          "find": {
            "selector": "#far",
            "moveTo": true
          }
        },
        {
          "goTo": "http://localhost:8092/click-shorthand.html"
        },
        {
          "find": "Click String Shorthand Test Page"
        },
        {
          "stopRecord": true
        }
      ]
    },
    {
      "testId": "headed-chrome-browser-engine",
      "description": "Headed Chrome still records with the browser engine. Not on Linux, where the fixture jobs have no display for a headed browser.",
      "runOn": [
        {
          "platforms": [
            "windows",
            "mac"
          ],
          "browsers": {
            "name": "chrome",
            "headless": false
          }
        }
      ],
      "steps": [
        {
          "goTo": "http://localhost:8092"
        },
        {
          "record": {
            "path": "headed-chrome-browser.mp4",
            "overwrite": "true",
            "verify": {
              "minDuration": 0.5,
              "notBlack": true
            }
          }
        },
        {
          "wait": 1500
        },
        {
          "stopRecord": true
        }
      ]
    },
    {
      "testId": "headless-firefox-skipped",
      "description": "Headless Firefox can't be recorded: the record and stopRecord steps are SKIPPED.",
      "runOn": [
        {
          "platforms": [
            "windows",
            "mac",
            "linux"
          ],
          "browsers": {
            "name": "firefox",
            "headless": true
          }
        }
      ],
      "steps": [
        {
          "goTo": "http://localhost:8092"
        },
        {
          "record": {
            "path": "headless-firefox.mp4",
            "overwrite": "true"
          }
        },
        {
          "stopRecord": true
        }
      ]
    },
    {
      "testId": "firefox-headless-omitted-skipped",
      "description": "Firefox with `headless` left out launches headless, so its record and stopRecord steps are SKIPPED too.",
      "runOn": [
        {
          "platforms": [
            "windows",
            "mac",
            "linux"
          ],
          "browsers": {
            "name": "firefox"
          }
        }
      ],
      "steps": [
        {
          "goTo": "http://localhost:8092"
        },
        {
          "record": {
            "path": "firefox-headless-omitted.mp4",
            "overwrite": "true"
          }
        },
        {
          "stopRecord": true
        }
      ]
    }
  ]
}
