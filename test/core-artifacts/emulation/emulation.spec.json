{
  "specId": "page-emulation",
  "description": "Page emulation keys on the context `browser` object (ADR 01223). One test per key per browser asserts what the page sees through `runBrowserScript`. A key the browser can't set skips the context: Safari for every key, and Firefox `timezone` and `clock`.",
  "tests": [
    {
      "testId": "chrome-colorScheme-dark",
      "description": "Chrome sets `colorScheme` to `dark`, and the page sees it.",
      "runOn": [
        {
          "platforms": [
            "windows",
            "mac",
            "linux"
          ],
          "browsers": [
            {
              "headless": true,
              "name": "chrome",
              "colorScheme": "dark"
            }
          ]
        }
      ],
      "steps": [
        {
          "goTo": "http://localhost:8092"
        },
        {
          "runBrowserScript": {
            "script": "return String(matchMedia('(prefers-color-scheme: dark)').matches);",
            "output": "/^true$/"
          }
        }
      ]
    },
    {
      "testId": "chrome-colorScheme-light",
      "description": "Chrome sets `colorScheme` to `light`, and the page sees it.",
      "runOn": [
        {
          "platforms": [
            "windows",
