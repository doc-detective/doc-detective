    {
      "testId": "chrome-every-key",
      "description": "Chrome sets every emulation key at once, and the page sees each one.",
      "runOn": [
        {
          "platforms": [
            "windows",
            "mac",
            "linux"
          ],
          "browsers": [
            {
              "headless": true,
              "name": "chrome",
              "colorScheme": "dark",
              "locale": "de-DE",
              "timezone": "Asia/Tokyo",
              "deviceScaleFactor": 2,
              "reducedMotion": "reduce",
              "clock": "2026-12-03T09:00:00Z"
            }
          ]
        }
      ],
      "steps": [
        {
          "goTo": "http://localhost:8092"
        },
        {
          "runBrowserScript": {
            "script": "return String(matchMedia('(prefers-color-scheme: dark)').matches);",
            "output": "/^true$/"
          }
        },
        {
          "runBrowserScript": {
            "script": "return navigator.language;",
            "output": "/^de-DE$/"
          }
        },
        {
          "runBrowserScript": {
            "script": "return Intl.DateTimeFormat().resolvedOptions().timeZone;",
            "output": "/^Asia\\/Tokyo$/"
          }
        },
        {
          "runBrowserScript": {
            "script": "return String(devicePixelRatio);",
            "output": "/^2$/"
          }
        },
        {
          "runBrowserScript": {
            "script": "return String(matchMedia('(prefers-reduced-motion: reduce)').matches);",
            "output": "/^true$/"
