{
  "specId": "download",
  "description": "checkFile `download` (ADR 01231): one test per permutation. The 8092 test server's /download route sends a CSV as an attachment, so the browser saves it to the context's download folder. Chrome and Firefox run headless on every OS. Safari asserts the skip on macOS.",
  "tests": [
    {
      "testId": "download-one-file",
      "description": "One export, checked by its name glob, in Chrome and Firefox.",
      "runOn": [
        {
          "platforms": [
            "windows",
            "mac",
            "linux"
          ],
          "browsers": [
            {
              "name": "chrome",
              "headless": true
            },
            {
              "name": "firefox",
              "headless": true
            }
          ]
        }
      ],
      "steps": [
        {
          "goTo": "http://localhost:8092/download.html"
        },
        {
          "click": "Export first CSV"
        },
        {
          "checkFile": {
            "download": "*.csv"
          }
        }
      ]
    },
    {
      "testId": "download-two-files",
      "description": "Two exports, then two checks, return two different files: the download folder is a queue.",
      "runOn": [
        {
          "platforms": [
            "windows",
            "mac",
            "linux"
          ],
          "browsers": [
            {
              "name": "chrome",
              "headless": true
            },
            {
              "name": "firefox",
              "headless": true
            }
          ]
        }
      ],
      "steps": [
        {
          "goTo": "http://localhost:8092/download.html"
        },
        {
          "click": "Export first CSV"
        },
        {
          "click": "Export second CSV"
        },
        {
          "checkFile": {
            "download": "report-*.csv"
          },
          "variables": {
            "DL_ONE": "$$fileName"
          }
        },
        {
          "checkFile": {
            "download": "report-*.csv"
          },
          "variables": {
            "DL_TWO": "$$fileName"
          }
        },
        {
          "description": "The two checks returned both files, once each.",
          "runShell": "node -e \"const n=[process.env.DL_ONE,process.env.DL_TWO].sort().join();if(n!=='report-first.csv,report-second.csv'){console.error(n);process.exit(1)}\""
        }
      ]
    },
    {
      "testId": "download-all-options",
      "description": "Every option at once: a glob, a content regex, a timeout, and the outputs read through process.env.",
      "runOn": [
        {
          "platforms": [
            "windows",
            "mac",
            "linux"
          ],
          "browsers": [
            {
              "name": "chrome",
              "headless": true
            }
          ]
        }
      ],
      "steps": [
        {
          "goTo": "http://localhost:8092/download.html"
        },
        {
          "click": "Export first CSV"
        },
        {
          "checkFile": {
            "download": "report-*.csv",
            "content": "/^id,name/",
            "timeout": 60000
          },
          "variables": {
            "DL_CSV": "$$filePath",
            "DL_SIZE": "$$fileSize"
          }
        },
        {
          "description": "The file sits in the context's download folder and holds the CSV.",
          "runShell": "node -e \"const fs=require('fs'),p=require('path'),f=process.env.DL_CSV;const ok=p.basename(p.dirname(f))==='downloads'&&fs.readFileSync(f,'utf8').startsWith('id,name')&&String(fs.statSync(f).size)===process.env.DL_SIZE;if(!ok){console.error(f);process.exit(1)}\""
        }
      ]
    },
    {
      "testId": "download-safari-skip",
      "description": "Safari can't save downloads to a known folder, so the step is Skipped.",
      "runOn": [
        {
          "platforms": [
            "mac"
          ],
          "browsers": [
            {
              "name": "safari"
            }
          ]
        }
      ],
      "steps": [
        {
          "goTo": "http://localhost:8092/download.html"
        },
        {
          "checkFile": {
            "download": "*.csv"
          }
        }
      ]
    },
    {
      "testId": "download-no-browser-skip",
      "description": "No step opens a browser, so there's no download folder and the step is Skipped.",
      "steps": [
        {
          "checkFile": {
            "download": "*.csv"
          }
        }
      ]
    }
  ]
}
