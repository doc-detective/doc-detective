{
  "specId": "cli-compare-runs",
  "description": "Each run compares with an earlier one and marks failures new, existing, or fixed (ADR 01216), and `failOn: new` exits 1 only for a new failure (ADR 01217), through the real CLI. Each test runs one case of compare-runs.cjs, which sets up a folder under .tmp/fixture-compare-runs/, runs doc-detective there once or twice, and checks the exit codes, stdout, stderr, results JSON, and testResults.md. No browser or network.",
  "tests": [
    {
      "testId": "compare-default-no-earlier-run",
      "description": "By default, a first run compares with nothing: no comparison in the results and no warning.",
      "steps": [
        {
          "runShell": {
            "command": "node test/core-artifacts/cli/compare-runs.cjs default-no-earlier-run",
            "workingDirectory": "../../.."
          }
        }
      ]
    },
    {
      "testId": "compare-default-existing",
      "description": "By default, a failure the previous run also had reads as existing, tagged `[already failing]` in the terminal summary and testResults.md.",
      "steps": [
        {
          "runShell": {
            "command": "node test/core-artifacts/cli/compare-runs.cjs default-existing",
            "workingDirectory": "../../.."
          }
        }
      ]
    },
    {
      "testId": "compare-default-new",
      "description": "By default, a failure the previous run didn't have reads as new, tagged `[new]` in the terminal summary and testResults.md.",
      "steps": [
        {
          "runShell": {
            "command": "node test/core-artifacts/cli/compare-runs.cjs default-new",
            "workingDirectory": "../../.."
          }
        }
      ]
    },
    {
      "testId": "compare-default-fixed",
      "description": "By default, a pass that failed in the previous run reads as fixed, under `Fixed (1):` in the terminal summary and `## Fixed` in testResults.md.",
      "steps": [
        {
          "runShell": {
            "command": "node test/core-artifacts/cli/compare-runs.cjs default-fixed",
            "workingDirectory": "../../.."
          }
        }
      ]
    },
