{
  "specId": "cli-routing-scope",
  "description": "Routing actions the runner can't perform at their scope make a spec invalid (ADR 01168), through the real CLI: exit 2. A test-level stop: spec still runs.",
  "tests": [
    {
      "testId": "setup",
      "description": "Writes the specs the other tests run.",
      "steps": [
        {
          "runShell": {
            "command": "node test/core-artifacts/cli/routing-scope-specs.cjs",
            "workingDirectory": "../../.."
          }
        }
      ]
    },
    {
      "testId": "step-scope-exit-2",
      "description": "A step handler with stop: spec, stop: run, or goToTest exits 2.",
      "steps": [
        {
          "runShell": {
            "command": "node ./bin/doc-detective.js -i .tmp/fixture-routing-scope/step-stop-spec.spec.json --output-dir .tmp/fixture-routing-scope/out",
            "workingDirectory": "../../..",
            "exitCodes": [
              2
            ],
            "stdio": "tests[0].steps[0].onFail[0].stop"
          }
        },
        {
          "runShell": {
            "command": "node ./bin/doc-detective.js -i .tmp/fixture-routing-scope/step-stop-run.spec.json --output-dir .tmp/fixture-routing-scope/out",
            "workingDirectory": "../../..",
            "exitCodes": [
              2
            ],
            "stdio": "tests[0].steps[0].onFail[0].stop"
          }
        },
        {
          "runShell": {
            "command": "node ./bin/doc-detective.js -i .tmp/fixture-routing-scope/step-goToTest.spec.json --output-dir .tmp/fixture-routing-scope/out",
            "workingDirectory": "../../..",
            "exitCodes": [
              2
            ],
            "stdio": "tests[0].steps[0].onFail[0]: unknown key 'goToTest'"
          }
        }
      ]
    },
    {
      "testId": "test-scope-exit-2",
      "description": "A test handler with stop: run, retry, or goToStep exits 2.",
      "steps": [
        {
          "runShell": {
            "command": "node ./bin/doc-detective.js -i .tmp/fixture-routing-scope/test-stop-run.spec.json --output-dir .tmp/fixture-routing-scope/out",
            "workingDirectory": "../../..",
            "exitCodes": [
              2
            ],
            "stdio": "tests[0].onFail[0].stop"
          }
        },
        {
          "runShell": {
            "command": "node ./bin/doc-detective.js -i .tmp/fixture-routing-scope/test-retry.spec.json --output-dir .tmp/fixture-routing-scope/out",
            "workingDirectory": "../../..",
            "exitCodes": [
              2
            ],
            "stdio": "tests[0].onFail[0]: unknown key 'retry'"
          }
        },
        {
          "runShell": {
            "command": "node ./bin/doc-detective.js -i .tmp/fixture-routing-scope/test-goToStep.spec.json --output-dir .tmp/fixture-routing-scope/out",
            "workingDirectory": "../../..",
            "exitCodes": [
              2
            ],
            "stdio": "tests[0].onFail[0]: unknown key 'goToStep'"
          }
        }
      ]
    },
    {
      "testId": "test-stop-spec-runs",
      "description": "A test handler with stop: spec is valid and runs.",
      "steps": [
        {
          "runShell": {
            "command": "node ./bin/doc-detective.js -i .tmp/fixture-routing-scope/test-stop-spec.spec.json --output-dir .tmp/fixture-routing-scope/out",
            "workingDirectory": "../../..",
            "exitCodes": [
              0
            ]
          }
        }
      ]
    },
    {
      "testId": "step-onSkip-retry-runs",
      "description": "retry in a step's onSkip is valid, and re-runs a step whose action reported SKIPPED.",
      "steps": [
        {
          "runShell": {
            "command": "node ./bin/doc-detective.js -i .tmp/fixture-routing-scope/step-onSkip-retry.spec.json --output-dir .tmp/fixture-routing-scope/out",
            "workingDirectory": "../../..",
            "exitCodes": [
              0
            ]
          }
        }
      ]
    }
  ]
}
