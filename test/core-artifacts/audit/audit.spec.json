{
  "specId": "audit",
  "description": "`doc-detective audit` through the real CLI (ADR 01207). Each test runs one case of audit-check.cjs, which writes documents and a config under .tmp/fixture-audit/, runs `audit`, and checks the report and exit code. No browser or network, so every case runs on Windows, macOS, and Linux.",
  "tests": [
    {
      "testId": "audit-tier-marker",
      "description": "A list after a procedure comment is explicit, whatever its first item says.",
      "steps": [
        {
          "runShell": {
            "command": "node test/core-artifacts/audit/audit-check.cjs tier-marker",
            "workingDirectory": "../../..",
            "exitCodes": [
              0
            ]
          }
        }
      ]
    },
    {
      "testId": "audit-tier-mdx-steps",
      "description": "Each Step in MDX Steps is an explicit procedure step.",
