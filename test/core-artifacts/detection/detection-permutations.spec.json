{
  "specId": "detection-permutations",
  "description": "Detection permutations through the real CLI (ADR 01139). fileTypes are config-level, so each test runs one case of dry-run-detect.cjs: it writes a document and config under .tmp/fixture-detection/, runs `doc-detective runTests --dry-run`, and compares the detected steps per test. Built-in cases pin legacy behavior (statements in code regions, lazy [comment]: # lines, {/* */} in .md, .mdx under the markdown built-in, the runner lowercase typeText rule); opt-in cases cover the mdx built-in and every selector kind, captures, followedBy.then chaining, container/regex dedupe, parse-failure fallback, and detectSteps: false. No browser or network, so every case runs on Windows, macOS, and Linux.",
  "tests": [
    {
      "testId": "detection-builtin-md-code-fence",
      "description": "Built-in fileType keeps its legacy detection: builtin-md-code-fence.",
      "steps": [
        {
          "runShell": {
            "command": "node test/core-artifacts/detection/dry-run-detect.cjs builtin-md-code-fence",
            "workingDirectory": "../../..",
            "exitCodes": [
              0
            ]
          }
        }
      ]
    },
    {
