{
  "specId": "selectors",
  "description": "Selector detection through the real CLI (ADR 01155, ADR 01157). fileTypes are config-level, so each test runs one case of dry-run-detect.cjs, which writes a document and config under .tmp/fixture-detection/, runs doc-detective, and checks the detected steps, exit code, and stderr. No browser or network, so every case runs on Windows, macOS, and Linux.",
  "tests": [
    {
      "testId": "selectors-markdown-kinds",
      "description": "Every kind Markdown produces, with both shorthands, and nothing from inside code.",
      "steps": [
        {
          "runShell": {
            "command": "node test/core-artifacts/detection/dry-run-detect.cjs markdown-kinds",
            "workingDirectory": "../../..",
            "exitCodes": [
              0
            ]
          }
        }
      ]
    },
    {
      "testId": "selectors-statement-containers",
      "description": "Each statement container form: comment, a container with regex, and one with a value field.",
      "steps": [
        {
          "runShell": {
            "command": "node test/core-artifacts/detection/dry-run-detect.cjs statement-containers",
            "workingDirectory": "../../..",
            "exitCodes": [
              0
            ]
          }
        }
      ]
    },
    {
      "testId": "selectors-definition-forms",
      "description": "Regex alone, a kind alone, and a kind with regex, in one fileType.",
      "steps": [
        {
          "runShell": {
            "command": "node test/core-artifacts/detection/dry-run-detect.cjs definition-forms",
            "workingDirectory": "../../..",
            "exitCodes": [
              0
            ]
          }
        }
      ]
    },
    {
      "testId": "selectors-mdx-components",
