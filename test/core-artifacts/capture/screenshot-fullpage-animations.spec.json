{
  "specId": "screenshot-fullpage-animations",
  "description": "`screenshot.fullPage` and `screenshot.animations` (ADR 01224) through the real runner. Chrome captures the document over BiDi, Firefox uses geckodriver's whole-page command, and Safari on a page larger than the screen is SKIPPED. `crop` with `fullPage`, app-surface rejection, BiDi, and mask offsets are pinned in test/screenshot-fullpage.test.js and src/common/test/validate.test.js.",
  "tests": [
    {
      "testId": "fullpage-chrome",
      "description": "`fullPage` in headless Chrome: the saved image is taller than the viewport, and the viewport and scroll are the same afterward.",
      "runOn": [
        {
          "platforms": [
            "windows",
            "mac",
            "linux"
          ],
          "browsers": {
            "name": "chrome",
            "headless": true
          }
        }
      ],
      "steps": [
        {
          "goTo": {
            "url": "http://localhost:8092/screenshot-tall.html",
            "waitUntil": {
              "networkIdleTime": 0,
              "domIdleTime": 0
            }
          }
        },
        {
          "runBrowserScript": "window.scrollTo(0, 500); return window.innerHeight + ':' + window.scrollY;",
          "variables": {
            "BEFORE": "$$result"
          }
        },
        {
          "stepId": "fullpage-chrome-capture",
          "screenshot": {
            "path": "fullpage-chrome.png",
            "directory": "static/images",
            "overwrite": "true",
            "fullPage": true
          },
          "variables": {
            "PAGE_HEIGHT": "$$height"
          }
        },
        {
          "runBrowserScript": "return window.innerHeight + ':' + window.scrollY;",
          "variables": {
            "AFTER": "$$result"
          }
        },
        {
          "description": "The image is taller than the viewport, and the viewport and scroll are back.",
          "runShell": "node -e \"const e = { b: process.env.BEFORE, a: process.env.AFTER, h: process.env.PAGE_HEIGHT }; const viewport = Number(e.b.split(':')[0]); if (!(Number(e.h) > viewport && e.a === e.b)) { console.error(JSON.stringify(e)); process.exit(1) }\""
        }
      ]
    },
    {
      "testId": "fullpage-firefox",
      "description": "`fullPage` in headless Firefox: the saved image is taller than the viewport, and the viewport and scroll are the same afterward.",
      "runOn": [
        {
          "platforms": [
            "windows",
            "mac",
            "linux"
          ],
          "browsers": {
            "name": "firefox",
            "headless": true
          }
