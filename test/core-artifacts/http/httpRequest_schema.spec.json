{
  "specId": "httpRequest-response-schema",
  "description": "httpRequest.response.schema checks the response body against an inline JSON Schema: types, formats, and patterns. The inline schema takes precedence over an OpenAPI response schema, and formats are enforced in both.",
  "tests": [
    {
      "testId": "httpRequest_schema_types_formats_pattern",
      "description": "An inline schema with types, formats, and a pattern passes on a matching body",
      "steps": [
        {
          "httpRequest": {
            "url": "http://localhost:8093/api/invoices",
            "method": "post",
            "request": {
              "body": {
                "id": "3f2b8c1e-9a4d-4e6f-8b1a-2c3d4e5f6a7b",
                "email": "billing@example.com",
                "created": "2026-11-26T10:00:00Z",
                "code": "INV-1042",
                "total": 19.99,
                "lines": [
                  {
                    "sku": "A1",
                    "qty": 2
                  }
                ]
              }
            },
            "response": {
              "schema": {
                "type": "object",
                "required": [
                  "id",
                  "email",
                  "created",
                  "code",
                  "total",
                  "lines"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "created": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "code": {
                    "type": "string",
                    "pattern": "^INV-\\d+$"
                  },
                  "total": {
                    "type": "number",
                    "minimum": 0
                  },
                  "lines": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "sku",
                        "qty"
                      ],
                      "properties": {
                        "qty": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    {
      "testId": "httpRequest_schema_with_body_and_required",
      "description": "response.schema combines with response.body and response.required",
      "steps": [
        {
          "httpRequest": {
            "url": "http://localhost:8093/api/users",
            "method": "post",
            "request": {
              "body": {
                "name": "Jo",
                "role": "admin",
                "id": "3f2b8c1e-9a4d-4e6f-8b1a-2c3d4e5f6a7b"
              }
            },
            "response": {
              "body": {
                "role": "admin"
              },
              "required": [
                "name"
              ],
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          }
        }
      ]
    },
    {
      "testId": "httpRequest_schema_with_allow_additional_fields_false",
      "description": "response.schema combines with allowAdditionalFields: false, and a schema default isn't added to the response as an extra field",
      "steps": [
        {
          "httpRequest": {
            "url": "http://localhost:8093/api/users",
            "method": "post",
            "request": {
              "body": {
                "id": "3f2b8c1e-9a4d-4e6f-8b1a-2c3d4e5f6a7b"
              }
            },
            "allowAdditionalFields": false,
            "response": {
              "body": {
                "id": "3f2b8c1e-9a4d-4e6f-8b1a-2c3d4e5f6a7b"
              },
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "active": {
                    "type": "boolean",
                    "default": true
                  }
                }
              }
            }
          }
        }
      ]
    },
    {
      "testId": "httpRequest_schema_overrides_openapi",
      "description": "The inline schema is used instead of the OpenAPI response schema: OpenAPI says integer, the inline schema says string",
      "steps": [
        {
          "httpRequest": {
            "openApi": {
              "descriptionPath": "./echo-schema.openapi.json",
              "operationId": "createItemIntegerId",
              "validateAgainstSchema": "response"
            },
            "request": {
              "body": {
                "id": "abc"
              }
            },
            "response": {
              "schema": {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      ]
    },
    {
      "testId": "httpRequest_schema_openapi_formats",
      "description": "An OpenAPI response schema with format: uuid passes on a real UUID (formats are now enforced)",
      "steps": [
        {
          "httpRequest": {
            "openApi": {
              "descriptionPath": "./echo-schema.openapi.json",
              "operationId": "createTokenUuid",
              "validateAgainstSchema": "response"
            },
            "request": {
              "body": {
                "token": "3f2b8c1e-9a4d-4e6f-8b1a-2c3d4e5f6a7b"
              }
            }
          }
        }
      ]
    }
  ]
}
