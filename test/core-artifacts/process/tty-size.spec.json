{
  "specId": "tty-size",
  "description": "The pseudo-terminal size of a background process: runShell `background.tty` as `true`, `{}`, `{cols, rows}` and `{cols}` alone, the startSurface process descriptor's `tty` object, and `false`. Each process prints the size it sees (`process.stdout.columns` x `process.stdout.rows`) and stays alive; readiness waits for the expected size, so a wrong size times out and FAILs. Where the optional node-pty dependency is unavailable, the start step is SKIPPED and `onSkip` stops the test, so it lands SKIPPED. `false` uses a pipe, needs no node-pty, and sees no size. Unique process names keep it safe under concurrentRunners.",
  "tests": [
    {
      "testId": "tty-size-true",
      "description": "`tty: true` gives the default 120 x 30 terminal.",
      "steps": [
        {
          "runShell": {
            "command": "node -e \"process.stdout.write('SIZE:'+process.stdout.columns+'x'+process.stdout.rows+':END');setInterval(()=>{},1000)\"",
            "background": {
              "name": "tty-size-true",
              "tty": true,
              "waitUntil": {
                "stdio": "/SIZE:120x30:END/"
              }
            },
            "timeout": 30000
          },
          "onSkip": [
            {
              "stop": "test"
            }
          ]
        },
        {
          "closeSurface": "tty-size-true"
        }
      ]
    },
    {
      "testId": "tty-size-empty-object",
      "description": "`tty: {}` turns PTY mode on at the default 120 x 30.",
      "steps": [
        {
          "runShell": {
            "command": "node -e \"process.stdout.write('SIZE:'+process.stdout.columns+'x'+process.stdout.rows+':END');setInterval(()=>{},1000)\"",
            "background": {
              "name": "tty-size-empty",
              "tty": {},
              "waitUntil": {
                "stdio": "/SIZE:120x30:END/"
              }
            },
            "timeout": 30000
          },
          "onSkip": [
            {
              "stop": "test"
            }
          ]
        },
        {
          "closeSurface": "tty-size-empty"
        }
      ]
    },
    {
      "testId": "tty-size-cols-rows",
      "description": "`tty: {cols: 80, rows: 24}` sets both dimensions.",
      "steps": [
        {
          "runShell": {
            "command": "node -e \"process.stdout.write('SIZE:'+process.stdout.columns+'x'+process.stdout.rows+':END');setInterval(()=>{},1000)\"",
            "background": {
              "name": "tty-size-80x24",
              "tty": {
                "cols": 80,
                "rows": 24
              },
              "waitUntil": {
                "stdio": "/SIZE:80x24:END/"
              }
            },
            "timeout": 30000
          },
          "onSkip": [
            {
              "stop": "test"
            }
          ]
        },
        {
          "closeSurface": "tty-size-80x24"
        }
      ]
    },
    {
      "testId": "tty-size-cols-only",
      "description": "`tty: {cols: 200}` sets the width and keeps the default 30 rows.",
      "steps": [
        {
          "runShell": {
            "command": "node -e \"process.stdout.write('SIZE:'+process.stdout.columns+'x'+process.stdout.rows+':END');setInterval(()=>{},1000)\"",
            "background": {
              "name": "tty-size-200",
              "tty": {
                "cols": 200
              },
              "waitUntil": {
                "stdio": "/SIZE:200x30:END/"
              }
            },
            "timeout": 30000
          },
          "onSkip": [
            {
              "stop": "test"
            }
          ]
        },
        {
          "closeSurface": "tty-size-200"
        }
      ]
    },
    {
      "testId": "tty-size-start-surface",
      "description": "The startSurface process descriptor takes the same `tty` object: 100 x 40.",
      "steps": [
        {
          "startSurface": {
            "process": "node -e \"process.stdout.write('SIZE:'+process.stdout.columns+'x'+process.stdout.rows+':END');setInterval(()=>{},1000)\"",
            "name": "tty-size-surface",
            "tty": {
              "cols": 100,
              "rows": 40
            },
            "waitUntil": {
              "stdio": "/SIZE:100x40:END/"
            },
            "timeout": 30000
          },
          "onSkip": [
            {
              "stop": "test"
            }
          ]
        },
        {
          "closeSurface": "tty-size-surface"
        }
      ]
    },
    {
      "testId": "tty-size-false",
      "description": "`tty: false` runs the process on a pipe, so it sees no terminal size. Needs no node-pty, so it always runs.",
      "steps": [
        {
          "runShell": {
            "command": "node -e \"process.stdout.write('SIZE:'+process.stdout.columns+'x'+process.stdout.rows+':END');setInterval(()=>{},1000)\"",
            "background": {
              "name": "tty-size-pipe",
              "tty": false,
              "waitUntil": {
                "stdio": "/SIZE:undefinedxundefined:END/"
              }
            },
            "timeout": 30000
          }
        },
        {
          "closeSurface": "tty-size-pipe"
        }
      ]
    }
  ]
}
