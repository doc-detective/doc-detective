{
  "specId": "matrix-browsers",
  "description": "A `matrix` crosses with the entry's browsers: two pages × Chrome and Firefox give four contexts (ADR 01240).",
  "tests": [
    {
      "testId": "matrix-times-browsers",
      "description": "Each context opens its own page and asserts the path it landed on.",
      "runOn": [
        {
          "platforms": [
            "windows",
            "mac",
            "linux"
          ],
          "browsers": [
            {
              "name": "chrome",
              "headless": true
            },
            {
              "name": "firefox",
              "headless": true
            }
          ],
          "matrix": {
            "page": [
              "find-click.html",
              "click-shorthand.html"
            ]
          }
        }
      ],
      "steps": [
        {
          "goTo": "http://localhost:8092/$$matrix.page"
        },
        {
          "runBrowserScript": {
            "script": "return location.pathname;",
            "output": "/$$matrix.page$/"
          }
        }
      ]
    }
  ]
}
