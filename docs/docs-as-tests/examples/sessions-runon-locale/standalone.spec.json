{
  "$schema": "https://raw.githubusercontent.com/doc-detective/doc-detective/main/src/common/dist/schemas/spec_v3.schema.json",
  "tests": [
    {
      "testId": "sessions-runon-locale",
      "runOn": [
        {
          "platforms": [
            "linux",
            "mac",
            "windows"
          ],
          "browsers": {
            "name": "chrome",
            "headless": true,
            "locale": "de-DE"
          }
        }
      ],
      "steps": [
        {
          "goTo": "http://localhost:8092/multi-tab.html"
        },
        {
          "runBrowserScript": {
            "script": "return navigator.language;",
            "output": "de-DE"
          }
        }
      ]
    }
  ]
}
