<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic PUBLIC "-//OASIS//DTD DITA Topic//EN" "topic.dtd">
<topic id="http-request-body-string">
  <title>Send a JSON string body</title>
  <body>
    <data name="doc-detective" value='test {"testId":"http-request-body-string","detectSteps":true}'/>
    <p>Send a <codeph>POST</codeph> request to <codeph>http://localhost:8093/api/users</codeph> with the JSON body <codeph>{"name": "Ada"}</codeph>. The response echoes it.</p>
    <data name="doc-detective" value='step {"httpRequest":{"url":"http://localhost:8093/api/users","method":"post","request":{"headers":{"Content-Type":"application/json"},"body":"{\"name\": \"Ada\"}"},"response":{"body":{"name":"Ada"}}}}'/>
    <data name="doc-detective" value="test end"/>
  </body>
</topic>
