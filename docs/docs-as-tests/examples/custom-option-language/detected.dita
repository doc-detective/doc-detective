<topic id="custom-option-language">
  <title>Check the page's status code</title>
  <body>
    <data name="doc-detective" value='test {"testId":"custom-option-language","detectSteps":true}'/>
    <p>Print the page's status code:</p>
    <codeblock outputclass="language-bash">curl -s -o /dev/null -w "%{http_code}" http://localhost:8092/type-echo.html</codeblock>
    <p>The command prints:</p>
    <codeblock outputclass="language-text">200</codeblock>
    <data name="doc-detective" value='test end'/>
  </body>
</topic>
