<!DOCTYPE topic PUBLIC "-//OASIS//DTD DITA Topic//EN" "topic.dtd">
<topic id="http-script-output-regex">
  <title>Run a script in the page</title>
  <body>
    <data name="doc-detective" value='test {"testId":"http-script-output-regex","detectSteps":false}'/>
    <p>Open the test site at <codeph>http://localhost:8092/</codeph>.</p>
    <data name="doc-detective" value='step {"goTo":"http://localhost:8092/"}'/>
    <p>Evaluate <codeph>window.location.href</codeph> in the console. It starts with the test site's address.</p>
    <data name="doc-detective" value='step {"runBrowserScript":{"script":"return window.location.href;","output":"/^http:\\/\\/localhost:8092/"}}'/>
    <data name="doc-detective" value="test end"/>
  </body>
</topic>
