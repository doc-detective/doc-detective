  "tests": [
    {
      "testId": "http-script-output-regex",
      "steps": [
        {
          "goTo": "http://localhost:8092/"
        },
        {
          "runBrowserScript": {
            "script": "return window.location.href;",
            "output": "/^http:\\/\\/localhost:8092/"
          }
        }
      ]
    }
  ]
}
