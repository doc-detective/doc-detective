<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="sessions-state-form-string">
  <title>Keep the browser state in a file</title>
  <taskbody>
    <data name="doc-detective" value='test {"testId":"sessions-state-form-string","detectSteps":true}'/>
    <steps>
      <step><cmd>Delete any <codeph>sessions-pstate.json</codeph> that an earlier run left in the output folder.</cmd>
        <info><data name="doc-detective" value='step {"runShell":"node -e \"require(&apos;fs&apos;).rmSync(&apos;docs/docs-as-tests/examples/.dd-output/sessions-pstate.json&apos;, { force: true })\""}'/></info></step>
      <step><cmd>Sign in at <xref href="http://localhost:8092/cookies/set/sessions_pstate/signed-in" scope="external" format="html">the sign-in page</xref>. The server sets the <codeph>sessions_pstate</codeph> cookie.</cmd>
        <info><data name="doc-detective" value='step {"goTo":"http://localhost:8092/cookies/set/sessions_pstate/signed-in"}'/></info></step>
      <step><cmd>Save the browser state to <codeph>sessions-pstate.json</codeph>.</cmd>
        <info><data name="doc-detective" value='step {"saveState":"sessions-pstate.json"}'/></info></step>
      <step><cmd>Sign out at <xref href="http://localhost:8092/cookies/set/sessions_pstate/signed-out" scope="external" format="html">the sign-out page</xref>, which replaces the cookie.</cmd>
        <info><data name="doc-detective" value='step {"goTo":"http://localhost:8092/cookies/set/sessions_pstate/signed-out"}'/></info></step>
      <step><cmd>Load the browser state from <codeph>sessions-pstate.json</codeph>.</cmd>
        <info><data name="doc-detective" value='step {"loadState":"sessions-pstate.json"}'/></info></step>
      <step><cmd>Open <xref href="http://localhost:8092/cookies" scope="external" format="html">the cookie report</xref>, and check that it shows <b>sessions_pstate=signed-in</b>.</cmd></step>
    </steps>
    <data name="doc-detective" value="test end"/>
  </taskbody>
</task>
