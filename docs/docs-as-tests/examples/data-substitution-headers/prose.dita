<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="data-substitution-headers">
  <title>Send a client name in a header</title>
  <taskbody>
    <steps>
      <step><cmd>Load the variables in <codeph>shop.env</codeph>.</cmd></step>
      <step><cmd>Send a <codeph>GET</codeph> request to <codeph>http://localhost:8092/api/products</codeph> with the header <codeph>X-Test: $SHOP_CLIENT</codeph>.</cmd></step>
    </steps>
  </taskbody>
</task>
