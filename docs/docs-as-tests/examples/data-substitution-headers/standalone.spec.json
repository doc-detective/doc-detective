{
  "$schema": "https://raw.githubusercontent.com/doc-detective/doc-detective/main/src/common/dist/schemas/spec_v3.schema.json",
  "tests": [
    {
      "testId": "data-substitution-headers",
      "steps": [
        {
          "loadVariables": "shop.env"
        },
        {
          "httpRequest": {
            "url": "http://localhost:8092/api/products",
            "method": "get",
            "request": {
              "headers": {
                "X-Test": "$SHOP_CLIENT"
              }
            },
            "response": {
              "headers": {
                "x-echo-test": "docs"
              }
            }
          }
        }
      ]
    }
  ]
}
