<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="nav-type-inputdelay">
  <title>Type slowly</title>
  <taskbody>
    <data name="doc-detective" value='test {"testId":"nav-type-inputdelay","detectSteps":false}'/>
    <steps>
      <step><cmd>Go to <xref href="http://localhost:8092/type-echo.html" scope="external" format="html">the type echo page</xref>.</cmd>
        <info><data name="doc-detective" value='step {"goTo":"http://localhost:8092/type-echo.html"}'/></info></step>
      <step><cmd>Click <b>Type here:</b>.</cmd>
        <info><data name="doc-detective" value='step {"click":"Type here:"}'/></info></step>
      <step><cmd>Type <codeph>Hello</codeph>, one key at a time.</cmd>
        <info><data name="doc-detective" value='step {"type":{"keys":"Hello","inputDelay":200}}'/></info></step>
      <step><cmd>Check that the page shows <b>Hello</b> below the field.</cmd>
        <info><data name="doc-detective" value='step {"find":"Hello"}'/></info></step>
    </steps>
    <data name="doc-detective" value="test end"/>
  </taskbody>
</task>
