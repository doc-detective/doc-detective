<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="nav-swipe-down">
  <title>Swipe down</title>
  <taskbody>
    <data name="doc-detective" value='test {"testId":"nav-swipe-down","detectSteps":false}'/>
    <steps>
      <step><cmd>Go to <xref href="http://localhost:8092/enhanced-elements.html" scope="external" format="html">the element test page</xref>.</cmd>
        <info><data name="doc-detective" value='step {"goTo":"http://localhost:8092/enhanced-elements.html"}'/></info></step>
      <step><cmd>Swipe down on the page.</cmd>
        <info><data name="doc-detective" value='step {"swipe":"down"}'/></info></step>
      <step><cmd>Check that <b>Submit by ID</b> is still on the page.</cmd>
        <info><data name="doc-detective" value='step {"find":"Submit by ID"}'/></info></step>
    </steps>
    <data name="doc-detective" value="test end"/>
  </taskbody>
</task>
