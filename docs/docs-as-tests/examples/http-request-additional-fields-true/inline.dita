<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic PUBLIC "-//OASIS//DTD DITA Topic//EN" "topic.dtd">
<topic id="http-request-additional-fields-true">
  <title>Allow extra response fields</title>
  <body>
    <data name="doc-detective" value='test {"testId":"http-request-additional-fields-true","detectSteps":false}'/>
    <p>Send a <codeph>POST</codeph> request to <codeph>http://localhost:8092/api/users</codeph> with the body <codeph>{"name": "Ada"}</codeph>. The response holds <codeph>name</codeph> and an extra field.</p>
    <data name="doc-detective" value='step {"httpRequest":{"url":"http://localhost:8092/api/users","method":"post","request":{"body":{"name":"Ada"}},"response":{"body":{"name":"Ada"}},"allowAdditionalFields":true}}'/>
    <data name="doc-detective" value="test end"/>
  </body>
</topic>
