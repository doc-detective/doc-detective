<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="data-route-onfail-retry-limit">
  <title>Wait for a service to be ready</title>
  <taskbody>
    <steps>
      <step><cmd>Check that the service is ready. If the check fails, check again:</cmd>
        <info><codeblock outputclass="language-shell">node -e "const fs=require('fs'),f=require('path').join(require('os').tmpdir(),'dd-data-route-onfail-retry-limit');if(fs.existsSync(f)){fs.rmSync(f)}else{fs.writeFileSync(f,'');console.error('Not ready yet.');process.exit(1)}"</codeblock></info></step>
    </steps>
  </taskbody>
</task>
