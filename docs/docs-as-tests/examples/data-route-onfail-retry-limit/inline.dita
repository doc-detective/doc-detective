<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="data-route-onfail-retry-limit">
  <title>Wait for a service to be ready</title>
  <taskbody>
    <data name="doc-detective" value='test {"testId":"data-route-onfail-retry-limit","detectSteps":false}'/>
    <steps>
      <step><cmd>Check that the service is ready. If the check fails, check again:</cmd>
        <info><codeblock outputclass="language-shell">node -e "const fs=require('fs'),f=require('path').join(require('os').tmpdir(),'dd-data-route-onfail-retry-limit');if(fs.existsSync(f)){fs.rmSync(f)}else{fs.writeFileSync(f,'');console.error('Not ready yet.');process.exit(1)}"</codeblock>
          <data name="doc-detective" value='step {"runShell":"node -e \"const fs=require(&apos;fs&apos;),f=require(&apos;path&apos;).join(require(&apos;os&apos;).tmpdir(),&apos;dd-data-route-onfail-retry-limit&apos;);if(fs.existsSync(f)){fs.rmSync(f)}else{fs.writeFileSync(f,&apos;&apos;);console.error(&apos;Not ready yet.&apos;);process.exit(1)}\"","onFail":[{"retry":{"limit":2}}]}'/></info></step>
    </steps>
    <data name="doc-detective" value="test end"/>
  </taskbody>
</task>
