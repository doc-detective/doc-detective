<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="sessions-surface-array">
  <title>Compare two Node.js REPLs</title>
  <taskbody>
    <data name="doc-detective" value='test {"testId":"sessions-surface-array","detectSteps":true,"runOn":[{"platforms":["linux","mac","windows"],"requires":"node"}]}'/>
    <steps>
      <step><cmd>Start two <codeph>node -i</codeph> processes, <codeph>sessions-pleft</codeph> and <codeph>sessions-pright</codeph>, and wait for both prompts.</cmd>
        <info><data name="doc-detective" value='step {"startSurface":[{"process":"node","args":["-i"],"name":"sessions-pleft","waitUntil":{"stdio":"/>/"},"timeout":30000},{"process":"node","args":["-i"],"name":"sessions-pright","waitUntil":{"stdio":"/>/"},"timeout":30000}]}'/></info></step>
      <step><cmd>In <codeph>sessions-pleft</codeph>, enter <codeph>40 + 2</codeph> and press Enter. Wait for the REPL to print <codeph>42</codeph>.</cmd>
        <info><data name="doc-detective" value='step {"type":{"keys":["40 + 2","$ENTER$"],"surface":"sessions-pleft","waitUntil":{"stdio":"/42/"},"timeout":10000}}'/></info></step>
      <step><cmd>In <codeph>sessions-pright</codeph>, enter <codeph>6 * 7</codeph> and press Enter. Wait for the REPL to print <codeph>42</codeph>.</cmd>
        <info><data name="doc-detective" value='step {"type":{"keys":["6 * 7","$ENTER$"],"surface":"sessions-pright","waitUntil":{"stdio":"/42/"},"timeout":10000}}'/></info></step>
      <step><cmd>Close both REPLs.</cmd>
        <info><data name="doc-detective" value='step {"closeSurface":["sessions-pleft",{"process":"sessions-pright"}]}'/></info></step>
    </steps>
    <data name="doc-detective" value="test end"/>
  </taskbody>
</task>
