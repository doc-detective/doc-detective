{
  "$schema": "https://raw.githubusercontent.com/doc-detective/doc-detective/main/src/common/dist/schemas/spec_v3.schema.json",
  "tests": [
    {
      "testId": "sessions-surface-array",
      "runOn": [
        {
          "platforms": [
            "linux",
            "mac",
            "windows"
          ],
          "requires": "node"
        }
      ],
      "steps": [
        {
          "startSurface": [
            {
              "process": "node",
              "args": [
                "-i"
              ],
              "name": "sessions-pleft",
              "waitUntil": {
                "stdio": "/>/"
              },
              "timeout": 30000
            },
            {
              "process": "node",
              "args": [
                "-i"
              ],
              "name": "sessions-pright",
              "waitUntil": {
                "stdio": "/>/"
              },
              "timeout": 30000
            }
          ]
        },
        {
          "type": {
            "keys": [
              "40 + 2",
              "$ENTER$"
            ],
            "surface": "sessions-pleft",
            "waitUntil": {
              "stdio": "/42/"
            },
            "timeout": 10000
          }
        },
        {
          "type": {
            "keys": [
              "6 * 7",
              "$ENTER$"
            ],
            "surface": "sessions-pright",
            "waitUntil": {
              "stdio": "/42/"
            },
            "timeout": 10000
          }
        },
        {
          "closeSurface": [
            "sessions-pleft",
            {
              "process": "sessions-pright"
            }
          ]
        }
      ]
    }
  ]
}
