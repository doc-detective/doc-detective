<task id="data-substitution-selector">
  <title>Type into a field named by a variable</title>
  <taskbody>
    <steps>
      <step><cmd>Load the variables in <codeph>shop.env</codeph>.</cmd></step>
      <step><cmd>Open <codeph>http://localhost:8092/type-echo.html</codeph>.</cmd></step>
      <step><cmd>Type <codeph>Wren</codeph> in the field.</cmd></step>
      <step><cmd>Check that the page shows <codeph>Wren</codeph>.</cmd></step>
    </steps>
  </taskbody>
</task>
