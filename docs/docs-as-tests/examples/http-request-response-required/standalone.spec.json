{
  "$schema": "https://raw.githubusercontent.com/doc-detective/doc-detective/main/src/common/dist/schemas/spec_v3.schema.json",
  "tests": [
    {
      "testId": "http-request-response-required",
      "steps": [
        {
          "httpRequest": {
            "url": "http://localhost:8093/api/orders",
            "method": "post",
            "request": {
              "body": {
                "user": {
                  "name": "Ada"
                },
                "items": [
                  {
                    "id": "inv-1"
                  }
                ]
              }
            },
            "response": {
              "required": [
                "user.name",
                "items[0].id"
              ]
            }
          }
        }
      ]
    }
  ]
}
