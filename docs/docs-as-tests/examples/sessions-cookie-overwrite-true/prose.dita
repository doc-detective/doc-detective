<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="sessions-cookie-overwrite-true">
  <title>Replace a saved cookie</title>
  <taskbody>
    <steps>
      <step><cmd>Sign in at <xref href="http://localhost:8092/cookies/set/sessions_pover/first" scope="external" format="html">the sign-in page</xref>. The server sets the <codeph>sessions_pover</codeph> cookie.</cmd></step>
      <step><cmd>Save the <codeph>sessions_pover</codeph> cookie to <codeph>sessions_pover.txt</codeph>, replacing any earlier file.</cmd></step>
      <step><cmd>Sign in again at <xref href="http://localhost:8092/cookies/set/sessions_pover/second" scope="external" format="html">the second sign-in page</xref>, and save the cookie to the same file.</cmd></step>
      <step><cmd>Sign out at <xref href="http://localhost:8092/cookies/set/sessions_pover/signed-out" scope="external" format="html">the sign-out page</xref>, which replaces the cookie.</cmd></step>
      <step><cmd>Load the cookie from <codeph>sessions_pover.txt</codeph>.</cmd></step>
      <step><cmd>Open <xref href="http://localhost:8092/cookies" scope="external" format="html">the cookie report</xref>, and check that it shows <b>sessions_pover=second</b>.</cmd></step>
    </steps>
  </taskbody>
</task>
