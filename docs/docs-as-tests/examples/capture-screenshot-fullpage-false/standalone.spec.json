{
  "$schema": "https://raw.githubusercontent.com/doc-detective/doc-detective/main/src/common/dist/schemas/spec_v3.schema.json",
  "tests": [
    {
      "testId": "capture-screenshot-fullpage-false",
      "steps": [
        {
          "goTo": {
            "url": "http://localhost:8092/screenshot-tall.html",
            "waitUntil": {
              "networkIdleTime": 0,
              "domIdleTime": 0
            }
          }
        },
        {
          "screenshot": {
            "path": "fullpage-false.png",
            "directory": ".dd-output",
            "overwrite": "true",
            "fullPage": false
          }
        }
      ]
    }
  ]
}
