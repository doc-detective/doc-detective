    <steps>
      <step><cmd>Start at <xref href="http://localhost:8092/cookies" scope="external" format="html">the cookies page</xref>.</cmd></step>
      <step><cmd>Check that the page lists <codeph>structure-session=signed-in</codeph>.</cmd></step>
    </steps>
  </taskbody>
</task>
