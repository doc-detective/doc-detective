<topic id="http-shell-exitcodes">
  <title>Expect a failing exit code</title>
  <body>
    <data name="doc-detective" value='test {"testId":"http-shell-exitcodes","detectSteps":false}'/>
    <p>This script exits with code <codeph>1</codeph>:</p>
    <codeblock outputclass="language-shell">node -e "process.exit(1)"</codeblock>
    <data name="doc-detective" value='step {"runShell":{"command":"node -e \"process.exit(1)\"","exitCodes":[1]}}'/>
    <data name="doc-detective" value="test end"/>
  </body>
</topic>
