{
  "$schema": "https://raw.githubusercontent.com/doc-detective/doc-detective/main/src/common/dist/schemas/spec_v3.schema.json",
  "tests": [
    {
      "testId": "sessions-contexts",
      "runOn": [
        {
          "contextId": "sessions-emulated-chrome",
          "platforms": [
            "linux",
            "mac",
            "windows"
          ],
          "browsers": {
            "name": "chrome",
            "headless": true,
            "colorScheme": "dark",
            "locale": "de-DE",
            "timezone": "Europe/Berlin",
            "deviceScaleFactor": 2,
            "reducedMotion": "reduce",
            "clock": "2026-12-03T09:00:00Z"
          }
        }
      ],
      "steps": [
        {
          "goTo": "http://localhost:8092/index.html"
        },
        {
          "runBrowserScript": {
            "script": "return String(matchMedia(\"(prefers-color-scheme: dark)\").matches);",
            "output": "true"
          }
        },
        {
          "runBrowserScript": {
            "script": "return String(matchMedia(\"(prefers-reduced-motion: reduce)\").matches);",
            "output": "true"
          }
        },
        {
          "runBrowserScript": {
            "script": "return navigator.language;",
            "output": "de-DE"
          }
        },
        {
          "runBrowserScript": {
            "script": "return Intl.DateTimeFormat().resolvedOptions().timeZone;",
            "output": "Europe/Berlin"
          }
        },
        {
          "runBrowserScript": {
            "script": "return String(devicePixelRatio);",
            "output": "2"
          }
        },
        {
          "runBrowserScript": {
            "script": "return new Date().toISOString();",
            "output": "/^2026-12-03T09:00/"
          }
        }
      ]
    }
  ]
}
