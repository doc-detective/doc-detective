<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="data-loadvariables-step-subfolder">
  <title>Check a service from an environment file in a child folder</title>
  <taskbody>
    <steps>
      <step><cmd>Load the variables in <codeph>env/service.env</codeph>.</cmd></step>
      <step><cmd>Check the service. Send a <codeph>GET</codeph> request to <codeph>$SERVICE_URL/health</codeph>.</cmd></step>
    </steps>
  </taskbody>
</task>
