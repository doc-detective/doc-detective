<task id="capture-annotationdefaults-test-over-config">
  <title>Outline a field when config and test set themes</title>
  <taskbody>
    <data name="doc-detective" value='test {"testId":"capture-annotationdefaults-test-over-config","detectSteps":true,"annotationDefaults":{"color":"#0EA5E9","strokeWidth":4}}'/>
    <steps>
      <step><cmd>Go to <xref href="http://localhost:8092/enhanced-elements.html" scope="external" format="html">the sample form</xref>.</cmd>
        <info><data name="doc-detective" value='step {"goTo":"http://localhost:8092/enhanced-elements.html"}'/></info></step>
      <step><cmd>The username field is outlined.</cmd>
        <info><data name="doc-detective" value='step {"screenshot":{"path":"defaults-test-over-config.png","directory":".dd-output","overwrite":"true","annotations":[{"outline":"#username-input"}]}}'/></info></step>
    </steps>
    <data name="doc-detective" value="test end"/>
  </taskbody>
</task>
