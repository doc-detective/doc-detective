<!DOCTYPE topic PUBLIC "-//OASIS//DTD DITA Topic//EN" "topic.dtd">
<topic id="http-request-parameters">
  <title>Send query parameters</title>
  <body>
    <data name="doc-detective" value='test {"testId":"http-request-parameters","detectSteps":true}'/>
    <p>Send a <codeph>GET</codeph> request to <codeph>http://localhost:8093/api/users</codeph> with the <codeph>page</codeph> parameter set to <codeph>2</codeph>. The response echoes it.</p>
    <data name="doc-detective" value='step {"httpRequest":{"url":"http://localhost:8093/api/users","request":{"parameters":{"page":"2"}},"response":{"body":{"page":"2"}}}}'/>
    <data name="doc-detective" value="test end"/>
  </body>
</topic>
