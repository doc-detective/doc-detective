{
  "$schema": "https://raw.githubusercontent.com/doc-detective/doc-detective/main/src/common/dist/schemas/spec_v3.schema.json",
  "tests": [
    {
      "testId": "sessions-cookie-form-name",
      "steps": [
        {
          "goTo": "http://localhost:8092/cookies/set/sessions_pname/signed-in"
        },
        {
          "saveCookie": "sessions_pname"
        },
        {
          "goTo": "http://localhost:8092/cookies/set/sessions_pname/signed-out"
        },
        {
          "loadCookie": "sessions_pname"
        },
        {
          "goTo": "http://localhost:8092/cookies"
        },
        {
          "find": "sessions_pname=signed-in"
        }
      ]
    }
  ]
}
