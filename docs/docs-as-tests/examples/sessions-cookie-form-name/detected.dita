<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="sessions-cookie-form-name">
  <title>Keep a cookie in an environment variable</title>
  <taskbody>
    <data name="doc-detective" value='test {"testId":"sessions-cookie-form-name","detectSteps":true}'/>
    <steps>
      <step><cmd>Sign in at <xref href="http://localhost:8092/cookies/set/sessions_pname/signed-in" scope="external" format="html">the sign-in page</xref>. The server sets the <codeph>sessions_pname</codeph> cookie.</cmd>
        <info><data name="doc-detective" value='step {"goTo":"http://localhost:8092/cookies/set/sessions_pname/signed-in"}'/></info></step>
      <step><cmd>Save the <codeph>sessions_pname</codeph> cookie to the <codeph>sessions_pname</codeph> environment variable.</cmd>
        <info><data name="doc-detective" value='step {"saveCookie":"sessions_pname"}'/></info></step>
      <step><cmd>Sign out at <xref href="http://localhost:8092/cookies/set/sessions_pname/signed-out" scope="external" format="html">the sign-out page</xref>, which replaces the cookie.</cmd>
        <info><data name="doc-detective" value='step {"goTo":"http://localhost:8092/cookies/set/sessions_pname/signed-out"}'/></info></step>
      <step><cmd>Load the cookie from the <codeph>sessions_pname</codeph> environment variable.</cmd>
        <info><data name="doc-detective" value='step {"loadCookie":"sessions_pname"}'/></info></step>
      <step><cmd>Open <xref href="http://localhost:8092/cookies" scope="external" format="html">the cookie report</xref>, and check that it shows <b>sessions_pname=signed-in</b>.</cmd></step>
    </steps>
    <data name="doc-detective" value="test end"/>
  </taskbody>
</task>
