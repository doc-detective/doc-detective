<topic id="http-request-method-post">
  <title>POST a user</title>
  <body>
    <data name="doc-detective" value='test {"testId":"http-request-method-post","detectSteps":false}'/>
    <p>Send a <codeph>POST</codeph> request to <codeph>http://localhost:8093/api/users</codeph> with the body <codeph>{"name":"Ada"}</codeph>.</p>
    <data name="doc-detective" value='step {"httpRequest":{"url":"http://localhost:8093/api/users","method":"post","request":{"body":{"name":"Ada"}},"response":{"body":{"name":"Ada"}}}}'/>
    <data name="doc-detective" value="test end"/>
  </body>
