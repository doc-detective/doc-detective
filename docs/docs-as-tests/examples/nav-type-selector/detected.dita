<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="nav-type-selector">
  <title>Type into a field by its selector</title>
  <taskbody>
    <data name="doc-detective" value='test {"testId":"nav-type-selector","detectSteps":true}'/>
    <steps>
      <step><cmd>Go to <xref href="http://localhost:8092/type-echo.html" scope="external" format="html">the type echo page</xref>.</cmd>
        <info><data name="doc-detective" value='step {"goTo":"http://localhost:8092/type-echo.html"}'/></info></step>
      <step><cmd>Type <codeph>Hello</codeph> into the <b>Type here:</b> field.</cmd>
        <info><data name="doc-detective" value='step {"type":{"keys":"Hello","selector":"#type-input"}}'/></info></step>
      <step><cmd>Check that the page shows <b>Hello</b> below the field.</cmd></step>
    </steps>
    <data name="doc-detective" value="test end"/>
  </taskbody>
</task>
