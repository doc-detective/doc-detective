<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic PUBLIC "-//OASIS//DTD DITA Topic//EN" "topic.dtd">
<topic id="http-shell-tty-object">
  <title>Run a process in a terminal</title>
  <body>
    <data name="doc-detective" value='test {"testId":"http-shell-tty-object","detectSteps":true}'/>
    <p>Print the terminal size the process sees. It's <codeph>100x40</codeph>:</p>
    <codeblock outputclass="language-shell">node -e "console.log('Terminal: ' + process.stdout.columns + 'x' + process.stdout.rows); setInterval(() =&gt; {}, 1000);"</codeblock>
    <data name="doc-detective" value='step {"runShell":{"command":"node -e \"console.log(&apos;Terminal: &apos; + process.stdout.columns + &apos;x&apos; + process.stdout.rows); setInterval(() => {}, 1000);\"","background":{"name":"http-shell-tty-object","tty":{"cols":100,"rows":40},"waitUntil":{"stdio":"Terminal: 100x40"}},"timeout":30000}}'/>
    <p>Stop it when you're done.</p>
    <data name="doc-detective" value='step {"closeSurface":"http-shell-tty-object"}'/>
    <data name="doc-detective" value="test end"/>
  </body>
</topic>
