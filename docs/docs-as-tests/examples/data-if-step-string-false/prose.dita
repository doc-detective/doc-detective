<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="data-if-step-string-false">
  <title>Show help only when Node.js fails</title>
  <taskbody>
    <steps>
      <step><cmd>Print the Node.js version:</cmd>
        <info><codeblock outputclass="language-shell">node --version</codeblock></info></step>
      <step><cmd>If that failed, print the help for <codeph>node</codeph>:</cmd>
        <info><codeblock outputclass="language-shell">node --help</codeblock></info></step>
    </steps>
  </taskbody>
</task>
