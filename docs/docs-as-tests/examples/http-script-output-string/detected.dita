<!DOCTYPE topic PUBLIC "-//OASIS//DTD DITA Topic//EN" "topic.dtd">
<topic id="http-script-output-string">
  <title>Run a script in the page</title>
  <body>
    <data name="doc-detective" value='test {"testId":"http-script-output-string","detectSteps":true}'/>
    <p>Open the test site at <codeph>http://localhost:8092/</codeph>.</p>
    <data name="doc-detective" value='step {"goTo":"http://localhost:8092/"}'/>
    <p>Evaluate <codeph>document.title</codeph> in the console. The title is <codeph>Basic HTML Elements Demo</codeph>.</p>
    <data name="doc-detective" value='step {"runBrowserScript":{"script":"return document.title;","output":"Basic HTML Elements Demo"}}'/>
    <data name="doc-detective" value="test end"/>
  </body>
</topic>
