<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="nav-goto-origin">
  <title>Open a page by its path</title>
  <taskbody>
    <data name="doc-detective" value='test {"testId":"nav-goto-origin","detectSteps":true}'/>
    <steps>
      <step><cmd>Go to <xref href="http://localhost:8092/enhanced-elements.html" scope="external" format="html">the element test page</xref>.</cmd>
        <info><data name="doc-detective" value='step {"goTo":{"url":"/enhanced-elements.html","origin":"http://localhost:8092"}}'/></info></step>
      <step><cmd>Check that the page shows <b>Submit by ID</b>.</cmd></step>
    </steps>
    <data name="doc-detective" value="test end"/>
  </taskbody>
</task>
