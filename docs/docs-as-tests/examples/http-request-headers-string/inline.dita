<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic PUBLIC "-//OASIS//DTD DITA Topic//EN" "topic.dtd">
<topic id="http-request-headers-string">
  <title>Send a header as a string</title>
  <body>
    <data name="doc-detective" value='test {"testId":"http-request-headers-string","detectSteps":false}'/>
    <p>Send a <codeph>GET</codeph> request to <codeph>http://localhost:8093/api/users</codeph> with the header <codeph>X-Test: docs</codeph>. The response's <codeph>x-echo-test</codeph> header is <codeph>docs</codeph>.</p>
    <data name="doc-detective" value='step {"httpRequest":{"url":"http://localhost:8093/api/users","request":{"headers":"X-Test: docs"},"response":{"headers":{"x-echo-test":"docs"}}}}'/>
    <data name="doc-detective" value="test end"/>
  </body>
</topic>
