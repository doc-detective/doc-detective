<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic PUBLIC "-//OASIS//DTD DITA Topic//EN" "topic.dtd">
<topic id="http-request-additional-fields-false">
  <title>Reject extra response fields</title>
  <body>
    <data name="doc-detective" value='test {"testId":"http-request-additional-fields-false","detectSteps":false}'/>
    <p>Send a <codeph>POST</codeph> request to <codeph>http://localhost:8093/api/users</codeph> with the body <codeph>{"name": "Ada"}</codeph>. The response holds only <codeph>name</codeph>.</p>
    <data name="doc-detective" value='step {"httpRequest":{"url":"http://localhost:8093/api/users","method":"post","request":{"body":{"name":"Ada"}},"response":{"body":{"name":"Ada"}},"allowAdditionalFields":false}}'/>
    <data name="doc-detective" value="test end"/>
  </body>
</topic>
