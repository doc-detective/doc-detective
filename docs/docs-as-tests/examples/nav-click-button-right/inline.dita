<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="nav-click-button-right">
  <title>Right-click a button</title>
  <taskbody>
    <data name="doc-detective" value='test {"testId":"nav-click-button-right","detectSteps":false}'/>
    <steps>
      <step><cmd>Go to <xref href="http://localhost:8092/find-click.html" scope="external" format="html">the click counter page</xref>.</cmd>
        <info><data name="doc-detective" value='step {"goTo":"http://localhost:8092/find-click.html"}'/></info></step>
      <step><cmd>Right-click <b>Count clicks</b>.</cmd>
        <info><data name="doc-detective" value='step {"click":{"selector":"#counter","button":"right"}}'/></info></step>
      <step><cmd>Check that the button counted the click.</cmd>
        <info><data name="doc-detective" value='step {"find":{"selector":"#counter","elementAttribute":{"data-right":"1"}}}'/></info></step>
    </steps>
    <data name="doc-detective" value="test end"/>
  </taskbody>
</task>
