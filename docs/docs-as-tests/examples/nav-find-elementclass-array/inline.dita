<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="nav-find-elementclass-array">
  <title>Find an element by several classes</title>
  <taskbody>
    <data name="doc-detective" value='test {"testId":"nav-find-elementclass-array","detectSteps":false}'/>
    <steps>
      <step><cmd>Go to <xref href="http://localhost:8092/enhanced-elements.html" scope="external" format="html">the element test page</xref>.</cmd>
        <info><data name="doc-detective" value='step {"goTo":"http://localhost:8092/enhanced-elements.html"}'/></info></step>
      <step><cmd>Find the <b>Large Secondary</b> button.</cmd>
        <info><data name="doc-detective" value='step {"find":{"elementClass":["btn","btn-secondary","btn-large"]}}'/></info></step>
    </steps>
    <data name="doc-detective" value="test end"/>
  </taskbody>
</task>
