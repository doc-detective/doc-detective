<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic PUBLIC "-//OASIS//DTD DITA Topic//EN" "topic.dtd">
<topic id="data-route-test-onskip-gototest">
  <title>Find Node.js, then check the API</title>
  <body>
    <section>
      <title>Find Node.js on Windows</title>
      <ol>
        <li>Find the Node.js executable:
          <codeblock outputclass="language-shell">where node</codeblock></li>
      </ol>
    </section>
    <section>
      <title>Check the cart</title>
      <ol>
        <li>Send a <codeph>GET</codeph> request to <codeph>http://localhost:8092/api/carts</codeph>.</li>
      </ol>
    </section>
    <section>
      <title>Check the products</title>
      <ol>
        <li>Send a <codeph>GET</codeph> request to <codeph>http://localhost:8092/api/products</codeph>.</li>
      </ol>
    </section>
  </body>
</topic>
