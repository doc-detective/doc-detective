<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="capture-screenshot-animations-disabled">
  <title>Save a screenshot of an animated page with animations disabled</title>
  <taskbody>
    <data name="doc-detective" value='test {"testId":"capture-screenshot-animations-disabled","detectSteps":false}'/>
    <steps>
      <step><cmd>Open the page at <codeph>http://localhost:8092/screenshot-loop.html</codeph>.</cmd>
        <info><data name="doc-detective" value='step {"goTo":{"url":"http://localhost:8092/screenshot-loop.html","waitUntil":{"networkIdleTime":0,"domIdleTime":0}}}'/></info></step>
      <step><cmd>A spinner turns in the middle of the page.</cmd>
        <info><data name="doc-detective" value='step {"screenshot":{"path":"animations-disabled.png","directory":".dd-output","overwrite":"true","animations":"disabled"}}'/></info></step>
    </steps>
    <data name="doc-detective" value="test end"/>
  </taskbody>
</task>
