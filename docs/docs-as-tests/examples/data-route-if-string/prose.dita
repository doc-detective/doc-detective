<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="data-route-if-string">
  <title>Skip ahead on desktop platforms</title>
  <taskbody>
    <steps>
      <step><cmd>Print the Node.js version:</cmd>
        <info><codeblock outputclass="language-shell">node --version</codeblock></info></step>
      <step><cmd>Print the npm version:</cmd>
        <info><codeblock outputclass="language-shell">npm --version</codeblock></info></step>
      <step><cmd>Find the Node.js executable:</cmd>
        <info><codeblock outputclass="language-shell">command -v node</codeblock></info></step>
    </steps>
  </taskbody>
</task>
