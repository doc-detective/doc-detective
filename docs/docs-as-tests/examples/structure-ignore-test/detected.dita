<!DOCTYPE topic PUBLIC "-//OASIS//DTD DITA Topic//EN" "topic.dtd">
<topic id="structure-ignore-test">
  <title>Check the demo pages</title>
  <body>
    <section>
      <title>Pages</title>
      <data name="doc-detective" value='test {"testId":"structure-ignore-test-pages","detectSteps":true}'/>
      <ol>
        <li>Check that <xref href="http://localhost:8092/index.html" scope="external" format="html">the elements demo</xref> loads.</li>
      </ol>
      <data name="doc-detective" value="test end"/>
      <data name="doc-detective" value="test ignore start"/>
    </section>
    <section>
      <title>API</title>
      <data name="doc-detective" value='test {"testId":"structure-ignore-test-api","detectSteps":true}'/>
      <ol>
        <li>Check that <xref href="http://localhost:8092/status/200" scope="external" format="html">the status endpoint</xref> answers.</li>
      </ol>
      <data name="doc-detective" value="test end"/>
      <data name="doc-detective" value="test ignore end"/>
    </section>
  </body>
</topic>
