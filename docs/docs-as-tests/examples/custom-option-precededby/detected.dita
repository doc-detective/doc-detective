<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic PUBLIC "-//OASIS//DTD DITA Topic//EN" "topic.dtd">
<topic id="custom-option-precededby">
  <title>Type into the field</title>
  <body>
    <data name="doc-detective" value='test {"testId":"custom-option-precededby","detectSteps":true}'/>
    <p>Open the type echo page.</p>
    <data name="doc-detective" value='step {"goTo":"http://localhost:8092/type-echo.html"}'/>
    <p>Click <b>Type here:</b>.</p>
    <p>Type Hello, Doc Detective.</p>
    <data name="doc-detective" value='step {"type":"Hello, Doc Detective"}'/>
    <p>The page shows <b>Hello, Doc Detective</b> below the field.</p>
    <data name="doc-detective" value='step {"find":"Hello, Doc Detective"}'/>
    <data name="doc-detective" value='test end'/>
  </body>
</topic>
