{
  "detectSteps": true,
  "resolveIncludes": false,
  "autoScreenshot": false,
  "autoRecord": false,
  "outputDir": ".dd-output",
  "beforeAll": "../../../test-setup/start-server.spec.json",
  "afterAll": "../../../test-setup/stop-server.spec.json",
  "telemetry": {
    "send": false
  },
  "fileTypes": [
    {
      "name": "markdown-custom",
      "extensions": [
        "md",
        "mdx"
      ],
      "inlineStatements": {
        "in": [
          "comment"
        ]
      },
      "markup": [
        {
          "name": "clickBold",
          "strong": {
            "precededBy": "\\b[Cc]lick\\s+$"
          },
          "actions": [
            "click"
          ]
        }
      ]
    },
    {
      "name": "asciidoc-custom",
      "extensions": [
        "adoc"
      ],
      "inlineStatements": {
        "in": [
          {
            "comment": {},
            "regex": "^\\(\\s*([\\s\\S]*?)\\s*\\)$"
          }
        ]
      },
      "markup": [
        {
          "name": "clickBold",
          "strong": {
            "precededBy": "\\b[Cc]lick\\s+$"
          },
          "actions": [
            "click"
          ]
        }
      ]
    },
    {
      "name": "html-custom",
      "extensions": [
        "html"
      ],
      "inlineStatements": {
        "in": [
          "comment"
        ]
      },
      "markup": [
        {
          "name": "clickBold",
          "strong": {
            "precededBy": "\\b[Cc]lick\\s+$"
          },
          "actions": [
            "click"
          ]
        }
      ]
    },
    {
      "name": "rst-custom",
      "extensions": [
        "rst"
      ],
      "inlineStatements": {
        "in": [
          "comment"
        ]
      },
      "markup": [
        {
          "name": "clickBold",
          "strong": {
            "precededBy": "\\b[Cc]lick\\s+$"
          },
          "actions": [
            "click"
          ]
        }
      ]
    },
    {
      "name": "dita-custom",
      "extensions": [
        "dita"
      ],
      "inlineStatements": {
        "in": [
          {
            "element": {
              "tag": [
                "data"
              ],
              "attributes": {
                "name": "^doc-detective$"
              }
            },
            "value": "attributes.value"
          }
        ]
      },
      "markup": [
        {
          "name": "clickBold",
          "strong": {
            "precededBy": "\\b[Cc]lick\\s+$"
          },
          "actions": [
            "click"
          ]
        }
      ]
    }
  ]
}
