<topic id="http-shell-bg-stdio">
  <title>Start a background process</title>
  <body>
    <data name="doc-detective" value='test {"testId":"http-shell-bg-stdio","detectSteps":false}'/>
    <p>Start the process:</p>
    <codeblock outputclass="language-shell">node -e "console.log('Preview ready'); setInterval(() =&gt; {}, 1000)"</codeblock>
    <data name="doc-detective" value='step {"runShell":{"command":"node -e \"console.log(&apos;Preview ready&apos;); setInterval(() => {}, 1000)\"","background":{"name":"http-shell-bg-stdio","waitUntil":{"stdio":"Preview ready"}},"timeout":15000}}'/>
    <p>Stop it when you're done.</p>
    <data name="doc-detective" value='step {"closeSurface":"http-shell-bg-stdio"}'/>
    <data name="doc-detective" value="test end"/>
  </body>
</topic>
