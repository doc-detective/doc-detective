{
  "$schema": "https://raw.githubusercontent.com/doc-detective/doc-detective/main/src/common/dist/schemas/spec_v3.schema.json",
  "tests": [
    {
      "testId": "http-shell-bg-stdio",
      "steps": [
        {
          "runShell": {
            "command": "node -e \"console.log('Preview ready'); setInterval(() => {}, 1000)\"",
            "background": {
              "name": "http-shell-bg-stdio",
              "waitUntil": {
                "stdio": "Preview ready"
              }
            },
            "timeout": 15000
          }
        },
        {
          "closeSurface": "http-shell-bg-stdio"
        }
      ]
    }
  ]
}
