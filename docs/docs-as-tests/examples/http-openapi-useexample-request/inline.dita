<!DOCTYPE topic PUBLIC "-//OASIS//DTD DITA Topic//EN" "topic.dtd">
<topic id="http-openapi-useexample-request">
  <title>Call an operation with its examples</title>
  <body>
    <data name="doc-detective" value='test {"testId":"http-openapi-useexample-request","detectSteps":false,"openApi":[{"name":"users","descriptionPath":"../http-openapi/users.openapi.json"}]}'/>
    <p>Call the <codeph>createUser</codeph> operation with its example user.</p>
    <data name="doc-detective" value='step {"httpRequest":{"openApi":{"operationId":"createUser","useExample":"request"}}}'/>
    <data name="doc-detective" value="test end"/>
  </body>
</topic>
