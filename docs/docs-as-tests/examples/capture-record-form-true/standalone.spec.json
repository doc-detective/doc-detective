{
  "$schema": "https://raw.githubusercontent.com/doc-detective/doc-detective/main/src/common/dist/schemas/spec_v3.schema.json",
  "tests": [
    {
      "testId": "capture-record-form-true",
      "autoRecord": false,
      "runOn": [
        {
          "platforms": [
            "windows",
            "mac",
            "linux"
          ],
          "browsers": {
            "name": "chrome",
            "headless": true
          }
        }
      ],
      "steps": [
        {
          "goTo": "http://localhost:8092/type-echo.html"
        },
        {
          "record": true
        },
        {
          "click": "Type here:"
        },
        {
          "type": "Hello"
        },
        {
          "wait": 1000
        },
        {
          "stopRecord": true
        }
      ]
    }
  ]
}
