<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="manage-users">
  <title>Manage users</title>
  <taskbody>
    <steps>
      <step><cmd>To create a user, send a <codeph>POST</codeph> request to <codeph>/api/users</codeph>:</cmd>
        <info><codeblock outputclass="language-http">POST http://localhost:8092/api/users
Content-Type: application/json

{"name": "Ada"}</codeblock></info></step>
      <step><cmd>To look up a user by name, send a <codeph>GET</codeph> request with a <codeph>name</codeph> parameter:</cmd>
        <info><codeblock outputclass="language-http">GET http://localhost:8092/api/users?name=Ada</codeblock></info></step>
      <step><cmd>To delete a user, send a <codeph>DELETE</codeph> request:</cmd>
        <info><codeblock outputclass="language-http">DELETE http://localhost:8092/api/users/ada</codeblock></info></step>
    </steps>
  </taskbody>
</task>
