<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="capture-screenshot-crop-padding-object">
  <title>Save a screenshot of one button with uneven padding</title>
  <taskbody>
    <data name="doc-detective" value='test {"testId":"capture-screenshot-crop-padding-object","detectSteps":false}'/>
    <steps>
      <step><cmd>Go to <xref href="http://localhost:8092/enhanced-elements.html" scope="external" format="html">the sample form</xref>.</cmd>
        <info><data name="doc-detective" value='step {"goTo":"http://localhost:8092/enhanced-elements.html"}'/></info></step>
      <step><cmd>The <b>Submit by ID</b> button is at the top of the form.</cmd>
        <info><data name="doc-detective" value='step {"screenshot":{"path":"crop-padding-object.png","directory":".dd-output","overwrite":"true","crop":{"elementText":"Submit by ID","padding":{"top":8,"right":16,"bottom":8,"left":16}}}}'/></info></step>
    </steps>
    <data name="doc-detective" value="test end"/>
  </taskbody>
</task>
