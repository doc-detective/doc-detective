{
  "detectSteps": true,
  "resolveIncludes": false,
  "autoScreenshot": false,
  "autoRecord": false,
  "beforeAll": "../../../test-setup/start-server.spec.json",
  "afterAll": "../../../test-setup/stop-server.spec.json",
  "telemetry": {
    "send": false
  },
  "fileTypes": [
    {
      "extends": "markdown",
      "markup": [
        {
          "name": "runCode",
          "codeBlock": { "language": ["javascript", "js"], "excludes": "^// Don't run" },
          "batchMatches": true,
          "actions": [{ "runCode": { "language": "javascript", "code": "$1" } }]
        }
      ]
    },
    {
      "extends": "asciidoc",
