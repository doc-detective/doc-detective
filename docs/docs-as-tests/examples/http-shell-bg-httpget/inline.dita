<!DOCTYPE topic PUBLIC "-//OASIS//DTD DITA Topic//EN" "topic.dtd">
<topic id="http-shell-bg-httpget">
  <title>Start a background process</title>
  <body>
    <data name="doc-detective" value='test {"testId":"http-shell-bg-httpget","detectSteps":false}'/>
    <p>Start a server on port 8242:</p>
    <codeblock outputclass="language-shell">node -e "require('http').createServer((q, r) =&gt; r.end('ok')).listen(8242)"</codeblock>
    <data name="doc-detective" value='step {"runShell":{"command":"node -e \"require(&apos;http&apos;).createServer((q, r) => r.end(&apos;ok&apos;)).listen(8242)\"","background":{"name":"http-shell-bg-httpget","waitUntil":{"httpGet":"http://localhost:8242/"}},"timeout":15000}}'/>
    <p>Stop it when you're done.</p>
    <data name="doc-detective" value='step {"closeSurface":"http-shell-bg-httpget"}'/>
    <data name="doc-detective" value="test end"/>
  </body>
</topic>
