<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="data-variables-array-index">
  <title>Look up the first item in a cart</title>
  <taskbody>
    <data name="doc-detective" value='test {"testId":"data-variables-array-index","detectSteps":false}'/>
    <steps>
      <step><cmd>Create a cart. Send a <codeph>POST</codeph> request to <codeph>http://localhost:8092/api/carts</codeph> with this body:</cmd>
        <info><codeblock outputclass="language-json">{"items":[{"sku":"A1","qty":2},{"sku":"B2","qty":1}]}</codeblock>
          <data name="doc-detective" value='step {"httpRequest":{"url":"http://localhost:8092/api/carts","method":"post","request":{"body":{"items":[{"sku":"A1","qty":2},{"sku":"B2","qty":1}]}}},"variables":{"FIRST_SKU":"$$response.body.items[0].sku"}}'/></info></step>
      <step><cmd>Look up the first item. Send a <codeph>GET</codeph> request to <codeph>http://localhost:8092/api/products?sku=&lt;sku&gt;</codeph>.</cmd>
        <info><data name="doc-detective" value='step {"httpRequest":{"url":"http://localhost:8092/api/products?sku=$FIRST_SKU","method":"get","response":{"body":{"sku":"A1"}}}}'/></info></step>
    </steps>
    <data name="doc-detective" value="test end"/>
  </taskbody>
</task>
