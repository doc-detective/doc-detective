<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="sessions-cookie-domain">
  <title>Keep the cookie for one domain</title>
  <taskbody>
    <data name="doc-detective" value='test {"testId":"sessions-cookie-domain","detectSteps":false}'/>
    <steps>
      <step><cmd>Sign in at <xref href="http://localhost:8092/cookies/set/sessions_pdomain/signed-in" scope="external" format="html">the sign-in page</xref>. The server sets the <codeph>sessions_pdomain</codeph> cookie.</cmd>
        <info><data name="doc-detective" value='step {"goTo":"http://localhost:8092/cookies/set/sessions_pdomain/signed-in"}'/></info></step>
      <step><cmd>Save the <codeph>localhost</codeph> cookie named <codeph>sessions_pdomain</codeph> to <codeph>sessions_pdomain.txt</codeph>.</cmd>
        <info><data name="doc-detective" value='step {"saveCookie":{"name":"sessions_pdomain","path":"sessions_pdomain.txt","domain":"localhost","overwrite":true}}'/></info></step>
      <step><cmd>Sign out at <xref href="http://localhost:8092/cookies/set/sessions_pdomain/signed-out" scope="external" format="html">the sign-out page</xref>, which replaces the cookie.</cmd>
        <info><data name="doc-detective" value='step {"goTo":"http://localhost:8092/cookies/set/sessions_pdomain/signed-out"}'/></info></step>
      <step><cmd>Load the <codeph>localhost</codeph> cookie from <codeph>sessions_pdomain.txt</codeph>.</cmd>
        <info><data name="doc-detective" value='step {"loadCookie":{"name":"sessions_pdomain","path":"sessions_pdomain.txt","domain":"localhost"}}'/></info></step>
      <step><cmd>Open <xref href="http://localhost:8092/cookies" scope="external" format="html">the cookie report</xref>, and check that it shows <b>sessions_pdomain=signed-in</b>.</cmd>
        <info><data name="doc-detective" value='step {"goTo":"http://localhost:8092/cookies"}'/><data name="doc-detective" value='step {"find":"sessions_pdomain=signed-in"}'/></info></step>
    </steps>
    <data name="doc-detective" value="test end"/>
  </taskbody>
</task>
