<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="data-substitution-body">
  <title>Send a client name in a request body</title>
  <taskbody>
    <data name="doc-detective" value='test {"testId":"data-substitution-body","detectSteps":true}'/>
    <steps>
      <step><cmd>Load the variables in <codeph>shop.env</codeph>.</cmd>
        <info><data name="doc-detective" value='step {"loadVariables":"shop.env"}'/></info></step>
      <step><cmd>Send a <codeph>POST</codeph> request to <codeph>http://localhost:8092/api/orders</codeph> with the body <codeph>{"client": "$SHOP_CLIENT"}</codeph>.</cmd>
        <info><data name="doc-detective" value='step {"httpRequest":{"url":"http://localhost:8092/api/orders","method":"post","request":{"body":{"client":"$SHOP_CLIENT"}},"response":{"body":{"client":"docs"}}}}'/></info></step>
    </steps>
    <data name="doc-detective" value="test end"/>
  </taskbody>
</task>
