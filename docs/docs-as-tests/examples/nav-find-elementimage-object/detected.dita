<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="nav-find-elementimage-object">
  <title>Find an element by an image with a threshold</title>
  <taskbody>
    <data name="doc-detective" value='test {"testId":"nav-find-elementimage-object","detectSteps":true}'/>
    <steps>
      <step><cmd>Go to <xref href="http://localhost:8092/find-image.html" scope="external" format="html">the toolbar page</xref>.</cmd>
        <info><data name="doc-detective" value='step {"goTo":"http://localhost:8092/find-image.html"}'/></info></step>
      <step><cmd>Find the save icon in the toolbar.</cmd>
        <info><data name="doc-detective" value='step {"find":{"elementImage":{"path":"save.svg","threshold":0.95}}}'/></info></step>
    </steps>
    <data name="doc-detective" value="test end"/>
  </taskbody>
</task>
