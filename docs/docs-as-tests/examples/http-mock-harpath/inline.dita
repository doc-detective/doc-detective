<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic PUBLIC "-//OASIS//DTD DITA Topic//EN" "topic.dtd">
<topic id="http-mock-harpath">
  <title>Replay recorded API responses</title>
  <body>
    <data name="doc-detective" value='test {"testId":"http-mock-harpath","detectSteps":false,"runOn":[{"platforms":["mac","linux"],"browsers":[{"name":"chrome","headless":true}]}]}'/>
    <p>Answer requests with the responses recorded in <codeph>plans.har</codeph>.</p>
    <data name="doc-detective" value='step {"mockRequest":{"harPath":"plans.har"}}'/>
    <p>Open the test site at <codeph>http://localhost:8092/</codeph>.</p>
    <data name="doc-detective" value='step {"goTo":"http://localhost:8092/"}'/>
    <p>Fetch <codeph>/api/plans</codeph>. The response is the recorded list, <codeph>pro</codeph> and <codeph>team</codeph>.</p>
    <data name="doc-detective" value='step {"runBrowserScript":{"script":"return fetch(&apos;/api/plans&apos;).then((r) => r.json());","output":"team"}}'/>
    <data name="doc-detective" value="test end"/>
  </body>
</topic>
