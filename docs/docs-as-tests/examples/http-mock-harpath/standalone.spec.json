{
  "$schema": "https://raw.githubusercontent.com/doc-detective/doc-detective/main/src/common/dist/schemas/spec_v3.schema.json",
  "tests": [
    {
      "testId": "http-mock-harpath",
      "runOn": [
        {
          "platforms": [
            "mac",
            "linux"
          ],
          "browsers": [
            {
              "name": "chrome",
              "headless": true
            }
          ]
        }
      ],
      "steps": [
        {
          "mockRequest": {
            "harPath": "plans.har"
          }
        },
        {
          "goTo": "http://localhost:8092/"
        },
        {
          "runBrowserScript": {
            "script": "return fetch('/api/plans').then((r) => r.json());",
            "output": "team"
          }
        }
      ]
    }
  ]
}
