<!DOCTYPE topic PUBLIC "-//OASIS//DTD DITA Topic//EN" "topic.dtd">
<topic id="http-shell-bg-port">
  <title>Start a background process</title>
  <body>
    <data name="doc-detective" value='test {"testId":"http-shell-bg-port","detectSteps":true}'/>
    <p>Start a server on port 8241:</p>
    <codeblock outputclass="language-shell">node -e "require('http').createServer((q, r) =&gt; r.end('ok')).listen(8241)"</codeblock>
    <data name="doc-detective" value='step {"runShell":{"command":"node -e \"require(&apos;http&apos;).createServer((q, r) => r.end(&apos;ok&apos;)).listen(8241)\"","background":{"name":"http-shell-bg-port","waitUntil":{"port":8241}},"timeout":15000}}'/>
    <p>Stop it when you're done.</p>
    <data name="doc-detective" value='step {"closeSurface":"http-shell-bg-port"}'/>
    <data name="doc-detective" value="test end"/>
  </body>
</topic>
