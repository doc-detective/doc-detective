<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="data-route-onfail-gotostep">
  <title>Find Node.js if the version check fails</title>
  <taskbody>
    <data name="doc-detective" value='test {"testId":"data-route-onfail-gotostep","detectSteps":false}'/>
    <steps>
      <step><cmd>Print the Node.js version:</cmd>
        <info><codeblock outputclass="language-shell">node --version</codeblock>
          <data name="doc-detective" value='step {"runShell":"node --version","onFail":[{"goToStep":"path"}]}'/></info></step>
      <step><cmd>Print the npm version:</cmd>
        <info><codeblock outputclass="language-shell">npm --version</codeblock>
          <data name="doc-detective" value='step {"stepId":"npm","runShell":"npm --version"}'/></info></step>
      <step><cmd>Find the Node.js executable:</cmd>
        <info><codeblock outputclass="language-shell">command -v node</codeblock>
          <data name="doc-detective" value='step {"stepId":"path","runShell":"command -v node"}'/></info></step>
    </steps>
    <data name="doc-detective" value="test end"/>
  </taskbody>
</task>
