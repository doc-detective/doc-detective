{
  "$schema": "https://raw.githubusercontent.com/doc-detective/doc-detective/main/src/common/dist/schemas/spec_v3.schema.json",
  "tests": [
    {
      "testId": "http-mock-method",
      "runOn": [
        {
          "platforms": [
            "mac",
            "linux"
          ],
          "browsers": [
            {
              "name": "chrome",
              "headless": true
            }
          ]
        }
      ],
      "steps": [
        {
          "mockRequest": {
            "url": "**/api/plans",
            "method": "POST",
            "response": {
              "body": "mocked-post"
            }
          }
        },
        {
          "goTo": "http://localhost:8092/"
        },
        {
          "runBrowserScript": {
            "script": "const u = '/api/plans'; return Promise.all([fetch(u).then((r) => r.text()), fetch(u, { method: 'POST' }).then((r) => r.text())]).then(([get, post]) => (get === 'mocked-post' ? 'GET was mocked' : 'GET passed') + ', POST ' + post);",
            "output": "GET passed, POST mocked-post"
          }
        }
      ]
    }
  ]
}
