<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="sessions-goto-new-boolean">
  <title>Open pages in a new tab and a new window</title>
  <taskbody>
    <data name="doc-detective" value='test {"testId":"sessions-goto-new-boolean","detectSteps":false}'/>
    <steps>
      <step><cmd>Start at <xref href="http://localhost:8092/multi-tab.html" scope="external" format="html">the multi-tab page</xref>.</cmd>
        <info><data name="doc-detective" value='step {"goTo":"http://localhost:8092/multi-tab.html"}'/></info></step>
      <step><cmd>Load <xref href="http://localhost:8092/multi-tab-child.html?page=tab" scope="external" format="html">the tab page</xref> in a new tab.</cmd>
        <info><data name="doc-detective" value='step {"goTo":{"url":"http://localhost:8092/multi-tab-child.html?page=tab","newTab":true}}'/></info></step>
      <step><cmd>Check that the page reads "PAGE tab".</cmd>
        <info><data name="doc-detective" value='step {"find":"PAGE tab"}'/></info></step>
      <step><cmd>Load <xref href="http://localhost:8092/multi-tab-child.html?page=window" scope="external" format="html">the window page</xref> in a new window.</cmd>
        <info><data name="doc-detective" value='step {"goTo":{"url":"http://localhost:8092/multi-tab-child.html?page=window","newWindow":true}}'/></info></step>
      <step><cmd>Check that the page reads "PAGE window".</cmd>
        <info><data name="doc-detective" value='step {"find":"PAGE window"}'/></info></step>
    </steps>
    <data name="doc-detective" value="test end"/>
  </taskbody>
</task>
