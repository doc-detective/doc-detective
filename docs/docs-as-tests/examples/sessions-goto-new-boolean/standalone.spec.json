{
  "$schema": "https://raw.githubusercontent.com/doc-detective/doc-detective/main/src/common/dist/schemas/spec_v3.schema.json",
  "tests": [
    {
      "testId": "sessions-goto-new-boolean",
      "steps": [
        {
          "goTo": "http://localhost:8092/multi-tab.html"
        },
        {
          "goTo": {
            "url": "http://localhost:8092/multi-tab-child.html?page=tab",
            "newTab": true
          }
        },
        {
          "find": "PAGE tab"
        },
        {
          "goTo": {
            "url": "http://localhost:8092/multi-tab-child.html?page=window",
            "newWindow": true
          }
        },
        {
          "find": "PAGE window"
        }
      ]
    }
  ]
}
