<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="nav-find-elements">
  <title>Fill in a form by element attributes</title>
  <taskbody>
    <data name="doc-detective" value='test {"testId":"nav-find-elements","detectSteps":false}'/>
    <steps>
      <step><cmd>Go to <xref href="http://localhost:8092/enhanced-elements.html" scope="external" format="html">the element test page</xref>.</cmd>
        <info><data name="doc-detective" value='step {"goTo":"http://localhost:8092/enhanced-elements.html"}'/></info></step>
      <step><cmd>Find the <b>Submit by ID</b> button near the top of the page.</cmd>
        <info><data name="doc-detective" value='step {"find":{"elementId":"submit-button","elementText":"Submit by ID","elementAria":"Submit form button","moveTo":true}}'/></info></step>
      <step><cmd>Click the username field and type "kittens".</cmd>
        <info><data name="doc-detective" value='step {"find":{"selector":"input","elementTestId":"username-field","click":true,"type":{"keys":["kittens"]},"timeout":10000}}'/></info></step>
      <step><cmd>Click the password field and type "hunter2".</cmd>
        <info><data name="doc-detective" value='step {"find":{"elementTestId":"password-field","elementClass":"form-control","click":"left","type":"hunter2","surface":"chrome"}}'/></info></step>
      <step><cmd>Click the contact email field and type "you@example.com".</cmd>
        <info><data name="doc-detective" value='step {"find":{"elementId":"contact-email","elementAttribute":{"data-validation":"email-regex-validator"},"click":true,"type":["you@example.com"]}}'/></info></step>
      <step><cmd>Type "-cat" at the end of the username.</cmd>
        <info><data name="doc-detective" value='step {"type":{"keys":"-cat","elementId":"username-input","elementTestId":"username-field","elementAttribute":{"placeholder":"Username"}}}'/></info></step>
      <step><cmd>Type "docs" in the search field, and wait for the page to settle.</cmd>
        <info><data name="doc-detective" value='step {"type":{"keys":["docs"],"elementAria":"Search input field","elementClass":["form-control"],"surface":"chrome","timeout":5000,"waitUntil":{"networkIdleTime":100,"domIdleTime":100,"find":{"elementTestId":"result-display","elementText":"Operation successful"}}}}'/></info></step>
      <step><cmd>Check that the <b>Submit Order</b> button is enabled.</cmd>
        <info><data name="doc-detective" value='step {"find":{"selector":"button","elementText":"/^Submit Ord/","elementTestId":"checkout-button","elementClass":["btn","/^btn-prim/"],"elementAttribute":{"data-enabled":"true","disabled":false}}}'/></info></step>
      <step><cmd>Click <b>Save</b>.</cmd>
        <info><data name="doc-detective" value='step {"click":{"elementText":"Save","elementAttribute":{"aria-label":"Save document button"},"elementClass":"btn-primary","timeout":5000,"surface":"chrome"}}'/></info></step>
      <step><cmd>Click <b>Login Submit</b>.</cmd>
        <info><data name="doc-detective" value='step {"click":{"elementTestId":"login-form-submit","elementClass":["btn","btn-large"],"surface":{"browser":"chrome"}}}'/></info></step>
      <step><cmd>Confirm that the page shows <b>Operation successful</b>.</cmd>
        <info><data name="doc-detective" value='step {"find":"Operation successful"}'/></info></step>
    </steps>
    <data name="doc-detective" value="test end"/>
  </taskbody>
</task>
