<topic id="http-shell-bg-delayms">
  <title>Start a background process</title>
  <body>
    <data name="doc-detective" value='test {"testId":"http-shell-bg-delayms","detectSteps":false}'/>
    <p>Start the process:</p>
    <codeblock outputclass="language-shell">node -e "setInterval(() =&gt; {}, 1000)"</codeblock>
    <data name="doc-detective" value='step {"runShell":{"command":"node -e \"setInterval(() => {}, 1000)\"","background":{"name":"http-shell-bg-delayms","waitUntil":{"delayMs":500}},"timeout":15000}}'/>
    <p>Stop it when you're done.</p>
    <data name="doc-detective" value='step {"closeSurface":"http-shell-bg-delayms"}'/>
    <data name="doc-detective" value="test end"/>
  </body>
</topic>
