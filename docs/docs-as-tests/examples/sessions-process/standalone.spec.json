{
  "$schema": "https://raw.githubusercontent.com/doc-detective/doc-detective/main/src/common/dist/schemas/spec_v3.schema.json",
  "tests": [
    {
      "testId": "sessions-process-surface",
      "runOn": [
        {
          "platforms": [
            "linux",
            "mac",
            "windows"
          ],
          "requires": "node"
        }
      ],
      "steps": [
        {
          "startSurface": {
            "process": "node",
            "args": [
              "-i"
            ],
            "name": "sessions-repl",
            "tty": true,
            "waitUntil": {
              "stdio": "/>/"
            },
            "timeout": 30000
          }
        },
        {
          "type": {
            "keys": [
              "40 + 2",
              "$ENTER$"
            ],
            "surface": "sessions-repl",
            "waitUntil": {
              "stdio": "/42/"
            },
            "timeout": 10000
          }
        },
        {
          "closeSurface": {
            "process": "sessions-repl"
          }
        }
      ]
    },
    {
      "testId": "sessions-process-background",
      "autoRecord": false,
      "runOn": [
        {
          "platforms": [
            "linux",
            "mac",
            "windows"
          ],
          "requires": {
            "commands": [
              "node"
            ],
            "env": [
              "PATH"
            ]
          }
        }
      ],
      "steps": [
        {
          "runShell": {
            "command": "node -i",
            "background": {
              "name": "sessions-bg-repl",
              "waitUntil": {
                "stdio": "/>/"
              }
            },
            "timeout": 30000
          }
        },
        {
          "type": {
            "keys": [
              "Math.pow(2, 10)",
              "$ENTER$"
            ],
            "surface": {
              "process": "sessions-bg-repl"
            },
            "waitUntil": {
              "stdio": "/1024/",
              "delayMs": 500
            },
            "timeout": 10000
          }
        },
        {
          "closeSurface": "sessions-bg-repl"
        }
      ]
    },
    {
      "testId": "sessions-process-server",
      "runOn": [
        {
          "platforms": [
            "linux",
            "mac",
            "windows"
          ],
          "requires": [
            "node",
            "npm"
          ]
        }
      ],
      "steps": [
        {
          "startSurface": [
            {
              "process": "node",
              "args": [
                "simple-json-server.cjs"
              ],
              "name": "sessions-api",
              "workingDirectory": "../../../fern/pages/docs/actions",
              "waitUntil": {
                "port": 8087,
                "httpGet": "http://localhost:8087"
              },
              "timeout": 30000
            },
            {
              "process": "node",
              "args": [
                "-i"
              ],
              "name": "sessions-client",
              "tty": {
                "cols": 100,
                "rows": 30
              },
              "waitUntil": {
                "delayMs": 1000
              }
            }
          ]
        },
        {
          "type": {
            "keys": [
              "fetch(\"http://localhost:8087\").then((r) => r.text()).then(console.log)",
              "$ENTER$"
            ],
            "surface": "sessions-client",
            "waitUntil": {
              "stdio": "/\"status\":\"ok\"/"
            },
            "timeout": 10000
          }
        },
        {
          "closeSurface": [
            "sessions-client",
            {
              "process": "sessions-api"
            }
          ]
        }
      ]
    }
  ]
}
