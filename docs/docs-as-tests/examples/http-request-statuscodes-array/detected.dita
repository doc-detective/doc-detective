<topic id="http-request-statuscodes-array">
  <title>Accept either success status</title>
  <body>
    <data name="doc-detective" value='test {"testId":"http-request-statuscodes-array","detectSteps":true}'/>
    <p>Send a <codeph>GET</codeph> request to <codeph>http://localhost:8092/status/201</codeph>. The status is <codeph>200</codeph> or <codeph>201</codeph>.</p>
    <data name="doc-detective" value='step {"httpRequest":{"url":"http://localhost:8092/status/201","statusCodes":[200,201]}}'/>
    <data name="doc-detective" value="test end"/>
  </body>
