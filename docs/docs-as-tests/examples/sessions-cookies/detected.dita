<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="sessions-cookies">
  <title>Keep a session cookie</title>
  <taskbody>
    <data name="doc-detective" value='test {"testId":"sessions-cookies","detectSteps":true}'/>
    <steps>
      <step><cmd>Sign in at <xref href="http://localhost:8092/cookies/set/sessions_demo/signed-in" scope="external" format="html">the sign-in page</xref>. The server sets the <codeph>sessions_demo</codeph> cookie.</cmd>
        <info><data name="doc-detective" value='step {"goTo":"http://localhost:8092/cookies/set/sessions_demo/signed-in"}'/></info></step>
      <step><cmd>Save the <codeph>sessions_demo</codeph> cookie four ways: to the <codeph>sessions_demo</codeph> and <codeph>SESSIONS_DEMO_COOKIE</codeph> environment variables, to <codeph>sessions_demo.txt</codeph> in the output folder, and to <codeph>sessions_demo.txt</codeph> in a <codeph>tmp</codeph> folder next to this file, keeping only the <codeph>localhost</codeph> cookie.</cmd>
        <info><data name="doc-detective" value='step {"saveCookie":"sessions_demo"}'/><data name="doc-detective" value='step {"saveCookie":{"name":"sessions_demo","variable":"SESSIONS_DEMO_COOKIE"}}'/><data name="doc-detective" value='step {"saveCookie":{"name":"sessions_demo","path":"sessions_demo.txt","overwrite":true}}'/><data name="doc-detective" value='step {"saveCookie":{"name":"sessions_demo","path":"sessions_demo.txt","directory":"tmp","domain":"localhost","overwrite":true}}'/></info></step>
      <step><cmd>Go to <xref href="http://localhost:8092/cookies/set/sessions_demo/signed-out" scope="external" format="html">the sign-out page</xref>, which replaces the cookie.</cmd></step>
      <step><cmd>Load the cookie from <codeph>sessions_demo.txt</codeph> in the output folder.</cmd>
        <info><data name="doc-detective" value='step {"loadCookie":"sessions_demo.txt"}'/></info></step>
      <step><cmd>Go to <xref href="http://localhost:8092/cookies" scope="external" format="html">the cookie report</xref>, and check that it shows <b>sessions_demo=signed-in</b>.</cmd></step>
      <step><cmd>Go to <xref href="http://localhost:8092/cookies/set/sessions_demo/signed-out" scope="external" format="html">the sign-out page</xref> again, and load the cookie from the <codeph>SESSIONS_DEMO_COOKIE</codeph> environment variable.</cmd>
        <info><data name="doc-detective" value='step {"loadCookie":{"name":"sessions_demo","variable":"SESSIONS_DEMO_COOKIE"}}'/></info></step>
      <step><cmd>Go to <xref href="http://localhost:8092/cookies" scope="external" format="html">the cookie report</xref> again, and check that it shows <b>sessions_demo=signed-in</b>.</cmd></step>
      <step><cmd>Go to <xref href="http://localhost:8092/cookies/set/sessions_demo/signed-out" scope="external" format="html">the sign-out page</xref> once more, and load the <codeph>localhost</codeph> cookie from <codeph>tmp/sessions_demo.txt</codeph>.</cmd>
        <info><data name="doc-detective" value='step {"loadCookie":{"name":"sessions_demo","path":"sessions_demo.txt","directory":"tmp","domain":"localhost"}}'/></info></step>
      <step><cmd>Go to <xref href="http://localhost:8092/cookies" scope="external" format="html">the cookie report</xref> a last time, and check that it shows <b>sessions_demo=signed-in</b>.</cmd></step>
    </steps>
    <data name="doc-detective" value="test end"/>
  </taskbody>
</task>
