  <title>Send a raw request from a plain block</title>
  <body>
    <data name="doc-detective" value='test {"testId":"http-request-block-untagged","detectSteps":false}'/>
    <p>Send this request:</p>
    <codeblock>GET http://localhost:8093/api/users?page=2
X-Test: docs</codeblock>
    <data name="doc-detective" value='step {"httpRequest":{"url":"http://localhost:8093/api/users?page=2","method":"get","request":{"headers":{"X-Test":"docs"}}}}'/>
    <data name="doc-detective" value="test end"/>
