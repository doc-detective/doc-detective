{
  "$schema": "https://raw.githubusercontent.com/doc-detective/doc-detective/main/src/common/dist/schemas/spec_v3.schema.json",
  "tests": [
    {
      "testId": "http-checkfile-content-string",
      "steps": [
        {
          "runShell": {
            "command": "node -e \"const fs=require('fs');fs.mkdirSync('output',{recursive:true});fs.writeFileSync('output/status.txt','deploy succeeded')\"",
            "workingDirectory": "."
          }
        },
        {
          "checkFile": {
            "path": "output/status.txt",
            "content": "succeeded"
          }
        }
      ]
    }
  ]
}
