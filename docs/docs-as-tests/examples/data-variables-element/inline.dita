<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="data-variables-element">
  <title>Send the text a page shows</title>
  <taskbody>
    <data name="doc-detective" value='test {"testId":"data-variables-element","detectSteps":false}'/>
    <steps>
      <step><cmd>Open <codeph>http://localhost:8092/type-echo.html</codeph>.</cmd>
        <info><data name="doc-detective" value='step {"goTo":"http://localhost:8092/type-echo.html"}'/></info></step>
      <step><cmd>Type <codeph>Wren</codeph> in the field.</cmd>
        <info><data name="doc-detective" value='step {"type":{"keys":"Wren","selector":"#type-input"}}'/></info></step>
      <step><cmd>Check that the page shows <codeph>Wren</codeph> below the field.</cmd>
        <info><data name="doc-detective" value='step {"find":{"selector":"#echo","elementText":"Wren"},"variables":{"ECHOED":"$$element.text"}}'/></info></step>
      <step><cmd>Send the text in a <codeph>POST</codeph> request to <codeph>http://localhost:8093/api/names</codeph>. The API returns it.</cmd>
        <info><data name="doc-detective" value='step {"httpRequest":{"url":"http://localhost:8093/api/names","method":"post","request":{"body":{"name":"$ECHOED"}},"response":{"body":{"name":"Wren"}}}}'/></info></step>
    </steps>
    <data name="doc-detective" value="test end"/>
  </taskbody>
</task>
