{
  "$schema": "https://raw.githubusercontent.com/doc-detective/doc-detective/main/src/common/dist/schemas/spec_v3.schema.json",
  "tests": [
    {
      "testId": "data-assertions-word",
      "steps": [
        {
          "httpRequest": {
            "url": "http://localhost:8092/api/accounts",
            "method": "post",
            "request": {
              "body": {
                "name": "Wren",
                "plan": "team"
              }
            }
          },
          "assertions": [
            "$$outputs.response.body.name contains \"Wr\"",
            "$$outputs.response.body.plan oneOf [free, team, enterprise]",
            "$$outputs.response.body.name matches /^W[a-z]+$/"
          ]
        }
      ]
    }
  ]
}
