<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="capture-annotationdefaults-config">
  <title>Outline a field with the config theme</title>
  <taskbody>
    <data name="doc-detective" value='test {"testId":"capture-annotationdefaults-config","detectSteps":true}'/>
    <steps>
      <step><cmd>Go to <xref href="http://localhost:8092/enhanced-elements.html" scope="external" format="html">the sample form</xref>.</cmd>
        <info><data name="doc-detective" value='step {"goTo":"http://localhost:8092/enhanced-elements.html"}'/></info></step>
      <step><cmd>The username field is outlined.</cmd>
        <info><data name="doc-detective" value='step {"screenshot":{"path":"defaults-config.png","directory":".dd-output","overwrite":"true","annotations":[{"outline":"#username-input"}]}}'/></info></step>
    </steps>
    <data name="doc-detective" value="test end"/>
  </taskbody>
</task>
