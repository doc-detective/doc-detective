<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="sessions-select-window-title">
  <title>Check a page in another tab or window</title>
  <taskbody>
    <steps>
      <step><cmd>Start at <xref href="http://localhost:8092/multi-tab.html" scope="external" format="html">the multi-tab page</xref>.</cmd></step>
      <step><cmd>Load <xref href="http://localhost:8092/multi-tab-child.html?page=second" scope="external" format="html">the second page</xref> in a new window named <codeph>second</codeph>.</cmd></step>
      <step><cmd>Check that the selected page reads "PAGE second".</cmd></step>
    </steps>
  </taskbody>
</task>
