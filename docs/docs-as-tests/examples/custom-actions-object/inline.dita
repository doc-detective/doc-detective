<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic PUBLIC "-//OASIS//DTD DITA Topic//EN" "topic.dtd">
<topic id="custom-actions-object">
  <title>Wait for the echo</title>
  <body>
    <data name="doc-detective" value='test {"testId":"custom-actions-object","detectSteps":false}'/>
    <p>Open the type echo page.</p>
    <data name="doc-detective" value='step {"goTo":"http://localhost:8092/type-echo.html"}'/>
    <p>Type Hello, Doc Detective.</p>
    <data name="doc-detective" value='step {"type":"Hello, Doc Detective"}'/>
    <p>Wait <i>a moment</i> for the echo.</p>
    <data name="doc-detective" value='step {"wait":500}'/>
    <data name="doc-detective" value='test end'/>
  </body>
</topic>
