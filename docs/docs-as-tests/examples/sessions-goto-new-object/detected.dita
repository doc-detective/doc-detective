<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="sessions-goto-new-object">
  <title>Open a named window with a named tab</title>
  <taskbody>
    <data name="doc-detective" value='test {"testId":"sessions-goto-new-object","detectSteps":true,"runOn":[{"browsers":{"name":"firefox","headless":true},"browserFallback":"off"}]}'/>
    <steps>
      <step><cmd>Start at <xref href="http://localhost:8092/multi-tab.html" scope="external" format="html">the multi-tab page</xref>.</cmd>
        <info><data name="doc-detective" value='step {"goTo":"http://localhost:8092/multi-tab.html"}'/></info></step>
      <step><cmd>Load <xref href="http://localhost:8092/multi-tab-child.html?page=report" scope="external" format="html">the report page</xref> in a new tab named <codeph>report</codeph>.</cmd>
        <info><data name="doc-detective" value='step {"goTo":{"url":"http://localhost:8092/multi-tab-child.html?page=report","newTab":{"name":"report"}}}'/></info></step>
      <step><cmd>Load <xref href="http://localhost:8092/multi-tab-child.html?page=settings" scope="external" format="html">the settings page</xref> in a new window named <codeph>settings</codeph>, with its first tab named <codeph>general</codeph>.</cmd>
        <info><data name="doc-detective" value='step {"goTo":{"url":"http://localhost:8092/multi-tab-child.html?page=settings","newWindow":{"name":"settings","tab":"general"}}}'/></info></step>
      <step><cmd>Check that the <codeph>general</codeph> tab of the <codeph>settings</codeph> window reads "PAGE settings".</cmd>
        <info><data name="doc-detective" value='step {"find":{"elementText":"PAGE settings","surface":{"browser":"firefox","window":{"name":"settings"},"tab":{"name":"general"}}}}'/></info></step>
    </steps>
    <data name="doc-detective" value="test end"/>
  </taskbody>
</task>
