<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="nav-click-duration">
  <title>Press and hold a button</title>
  <taskbody>
    <data name="doc-detective" value='test {"testId":"nav-click-duration","detectSteps":false}'/>
    <steps>
      <step><cmd>Go to <xref href="http://localhost:8092/find-click.html" scope="external" format="html">the click counter page</xref>.</cmd>
        <info><data name="doc-detective" value='step {"goTo":"http://localhost:8092/find-click.html"}'/></info></step>
      <step><cmd>Press and hold <b>Count clicks</b> for one second.</cmd>
        <info><data name="doc-detective" value='step {"click":{"selector":"#counter","duration":1000}}'/></info></step>
      <step><cmd>Check that the button counted the click.</cmd>
        <info><data name="doc-detective" value='step {"find":{"selector":"#counter","elementAttribute":{"data-left":"1"}}}'/></info></step>
    </steps>
    <data name="doc-detective" value="test end"/>
  </taskbody>
</task>
