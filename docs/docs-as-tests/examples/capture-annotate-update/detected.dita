<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="capture-annotate-update">
  <title>Move a mark to the next field</title>
  <taskbody>
    <data name="doc-detective" value='test {"testId":"capture-annotate-update","detectSteps":true}'/>
    <steps>
      <step><cmd>Go to <xref href="http://localhost:8092/enhanced-elements.html" scope="external" format="html">the sample form</xref>.</cmd>
        <info><data name="doc-detective" value='step {"goTo":"http://localhost:8092/enhanced-elements.html"}'/></info></step>
      <step><cmd>The username field is marked 1.</cmd>
        <info><data name="doc-detective" value='step {"annotate":{"add":[{"id":"step","badge":"#username-input","label":"1"}]}}'/></info></step>
      <step><cmd>Then the button is marked 2.</cmd>
        <info><data name="doc-detective" value='step {"annotate":{"update":[{"id":"step","badge":"#submit-button","label":"2"}]}}'/>
          <data name="doc-detective" value='step {"screenshot":{"path":"annotate-update.png","directory":".dd-output","overwrite":"true"}}'/></info></step>
    </steps>
    <data name="doc-detective" value="test end"/>
  </taskbody>
</task>
