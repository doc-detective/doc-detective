<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="nav-checklink-headers-object">
  <title>Send headers as an object</title>
  <taskbody>
    <data name="doc-detective" value='test {"testId":"nav-checklink-headers-object","detectSteps":false}'/>
    <steps>
      <step><cmd>Check that <xref href="http://localhost:8092/api/health" scope="external" format="html">the API health check</xref> responds.</cmd>
        <info><data name="doc-detective" value='step {"checkLink":{"url":"http://localhost:8092/api/health","headers":{"Accept":"application/json","X-Test":"docs"}}}'/></info></step>
    </steps>
    <data name="doc-detective" value="test end"/>
  </taskbody>
</task>
