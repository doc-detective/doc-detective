<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dita PUBLIC "-//OASIS//DTD DITA Composite//EN" "ditabase.dtd">
<dita>
  <topic id="sessions-process">
    <title>Evaluate expressions in the Node.js REPL</title>
  </topic>
  <task id="sessions-process-surface">
    <title>Start the REPL as a surface</title>
    <taskbody>
      <data name="doc-detective" value='test {"testId":"sessions-process-surface","detectSteps":false,"runOn":[{"platforms":["linux","mac","windows"],"requires":"node"}]}'/>
      <steps>
        <step><cmd>Start <codeph>node -i</codeph> in a terminal as a process named <codeph>sessions-repl</codeph>, and wait for the <codeph>&gt;</codeph> prompt.</cmd>
          <info><data name="doc-detective" value='step {"startSurface":{"process":"node","args":["-i"],"name":"sessions-repl","tty":true,"waitUntil":{"stdio":"/>/"},"timeout":30000}}'/></info></step>
        <step><cmd>In the REPL, enter <codeph>40 + 2</codeph> and press Enter. Wait for the REPL to print <codeph>42</codeph>.</cmd>
          <info><data name="doc-detective" value='step {"type":{"keys":["40 + 2","$ENTER$"],"surface":"sessions-repl","waitUntil":{"stdio":"/42/"},"timeout":10000}}'/></info></step>
        <step><cmd>Close the REPL.</cmd>
          <info><data name="doc-detective" value='step {"closeSurface":{"process":"sessions-repl"}}'/></info></step>
      </steps>
      <data name="doc-detective" value="test end"/>
    </taskbody>
  </task>
  <task id="sessions-process-background">
    <title>Run the REPL in the background</title>
    <taskbody>
      <data name="doc-detective" value='test {"testId":"sessions-process-background","detectSteps":false,"autoRecord":false,"runOn":[{"platforms":["linux","mac","windows"],"requires":{"commands":["node"],"env":["PATH"]}}]}'/>
      <steps>
        <step><cmd>Run <codeph>node -i</codeph> in the background as a process named <codeph>sessions-bg-repl</codeph>, and wait for the <codeph>&gt;</codeph> prompt.</cmd>
          <info><data name="doc-detective" value='step {"runShell":{"command":"node -i","background":{"name":"sessions-bg-repl","waitUntil":{"stdio":"/>/"}},"timeout":30000}}'/></info></step>
        <step><cmd>In the REPL, enter <codeph>Math.pow(2, 10)</codeph> and press Enter. Wait at least half a second, and until the REPL prints <codeph>1024</codeph>.</cmd>
          <info><data name="doc-detective" value='step {"type":{"keys":["Math.pow(2, 10)","$ENTER$"],"surface":{"process":"sessions-bg-repl"},"waitUntil":{"stdio":"/1024/","delayMs":500},"timeout":10000}}'/></info></step>
        <step><cmd>Close the REPL.</cmd>
          <info><data name="doc-detective" value='step {"closeSurface":"sessions-bg-repl"}'/></info></step>
      </steps>
      <data name="doc-detective" value="test end"/>
    </taskbody>
  </task>
  <task id="sessions-process-server">
    <title>Start a server and a REPL together</title>
    <taskbody>
      <data name="doc-detective" value='test {"testId":"sessions-process-server","detectSteps":false,"runOn":[{"platforms":["linux","mac","windows"],"requires":["node","npm"]}]}'/>
      <steps>
        <step><cmd>From the <codeph>docs/actions</codeph> folder, start <codeph>node simple-json-server.cjs</codeph> as <codeph>sessions-api</codeph>, and wait until port <codeph>8087</codeph> answers. At the same time, start <codeph>node -i</codeph> in a 100 by 30 terminal as <codeph>sessions-client</codeph>, and give it a second to start.</cmd>
          <info><data name="doc-detective" value='step {"startSurface":[{"process":"node","args":["simple-json-server.cjs"],"name":"sessions-api","workingDirectory":"../../../../docs/actions","waitUntil":{"port":8087,"httpGet":"http://localhost:8087"},"timeout":30000},{"process":"node","args":["-i"],"name":"sessions-client","tty":{"cols":100,"rows":30},"waitUntil":{"delayMs":1000}}]}'/></info></step>
        <step><cmd>In the REPL, fetch the server's root URL, and wait for it to print <codeph>ok</codeph>.</cmd>
          <info><data name="doc-detective" value='step {"type":{"keys":["fetch(\"http://localhost:8087\").then((r) => r.text()).then(console.log)","$ENTER$"],"surface":"sessions-client","waitUntil":{"stdio":"/\"status\":\"ok\"/"},"timeout":10000}}'/></info></step>
        <step><cmd>Close the REPL and the server.</cmd>
          <info><data name="doc-detective" value='step {"closeSurface":["sessions-client",{"process":"sessions-api"}]}'/></info></step>
      </steps>
      <data name="doc-detective" value="test end"/>
    </taskbody>
  </task>
</dita>
