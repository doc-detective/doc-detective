<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="nav-drag-swipe">
  <title>Drag widgets and scroll the page</title>
  <taskbody>
    <data name="doc-detective" value='test {"testId":"nav-drag-swipe","detectSteps":true}'/>
    <steps>
      <step><cmd>Go to <xref href="http://localhost:8092/drag-drop-test.html" scope="external" format="html">the drag and drop page</xref>.</cmd>
        <info><data name="doc-detective" value='step {"goTo":"http://localhost:8092/drag-drop-test.html"}'/></info></step>
      <step><cmd>Drag <b>Table</b> onto <b>Drop Zone 1</b>.</cmd>
        <info><data name="doc-detective" value='step {"dragAndDrop":{"source":"Table","target":{"selector":".drop-zone","elementText":"Drop Zone 1","timeout":5000},"duration":500}}'/></info></step>
      <step><cmd>Check that <b>Table (dropped)</b> appears in the drop zone.</cmd></step>
      <step><cmd>Press and hold <b>Chart</b> for one second.</cmd>
        <info><data name="doc-detective" value='step {"click":{"selector":".draggable[data-widget=\"chart\"]","button":"left","duration":1000}}'/></info></step>
      <step><cmd>Drag <b>Chart</b> onto <b>Drop Zone 2</b>.</cmd>
        <info><data name="doc-detective" value='step {"dragAndDrop":{"source":{"elementText":"Chart","elementClass":"draggable","elementAttribute":{"data-widget":"chart","draggable":"true"},"timeout":5000},"target":".drop-zone[data-drop=\"zone2\"]","surface":"chrome"}}'/></info></step>
      <step><cmd>Check that <b>Chart (dropped)</b> appears in the second drop zone.</cmd></step>
      <step><cmd>Swipe up to scroll toward the bottom of the page.</cmd>
        <info><data name="doc-detective" value='step {"swipe":"up"}'/></info></step>
      <step><cmd>Swipe down a third of the screen to scroll back.</cmd>
        <info><data name="doc-detective" value='step {"swipe":{"direction":"down","distance":0.3,"duration":300,"surface":"chrome"}}'/></info></step>
      <step><cmd>Swipe from the middle of the page toward the top.</cmd>
        <info><data name="doc-detective" value='step {"swipe":{"from":{"x":400,"y":400},"to":{"x":400,"y":250},"duration":300,"surface":{"browser":"chrome"}}}'/></info></step>
    </steps>
    <data name="doc-detective" value="test end"/>
  </taskbody>
</task>
