{
  "$schema": "https://raw.githubusercontent.com/doc-detective/doc-detective/main/src/common/dist/schemas/spec_v3.schema.json",
  "tests": [
    {
      "testId": "http-mock-request",
      "runOn": [
        {
          "platforms": [
            "windows",
            "mac",
            "linux"
          ],
          "browsers": [
            {
              "name": "chrome",
              "headless": true
            }
          ]
        }
      ],
      "steps": [
        {
          "mockRequest": {
            "url": "**/api/invoices*",
            "method": "GET",
            "response": {
              "statusCode": 200,
              "headers": {
                "x-mock": "docs"
              },
              "bodyPath": "invoices.json"
            }
          }
        },
        {
          "mockRequest": {
            "url": "http://localhost:8092/api/invoices",
            "method": "POST",
            "response": {
              "statusCode": 201,
              "body": {
                "id": "inv-2"
              }
            }
          }
        },
        {
          "goTo": "http://localhost:8092/"
        },
        {
          "runBrowserScript": {
            "script": "return fetch(arguments[0]).then(async (r) => r.headers.get('x-mock') + ' ' + JSON.stringify(await r.json()));",
            "args": [
              "/api/invoices?page=1"
            ],
            "output": "/^docs .*inv-1/",
            "timeout": 10000
          }
        },
        {
          "runBrowserScript": {
            "script": "return fetch('/api/invoices', { method: 'POST' }).then((r) => r.status);",
            "output": "201"
          }
        },
        {
          "runBrowserScript": "return document.title;"
        }
      ]
    }
  ]
}
