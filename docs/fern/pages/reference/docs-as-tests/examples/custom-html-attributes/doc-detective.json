{
  "detectSteps": true,
  "resolveIncludes": false,
  "autoScreenshot": false,
  "autoRecord": false,
  "beforeAll": "../../../../../../test-setup/start-server.spec.json",
  "afterAll": "../../../../../../test-setup/stop-server.spec.json",
  "telemetry": {
    "send": false
  },
  "fileTypes": [
    {
      "extends": "html",
      "inlineStatements": {
        "in": [{ "element": { "tag": ["div"], "attributes": { "data-test": true } }, "value": "attributes.data-test" }]
      },
      "markup": [
        {
          "name": "goToUrl",
          "link": { "url": "^https?://", "precededBy": "\\b[Gg]o to\\s+$" },
          "captures": ["url"],
          "actions": ["goTo"]
        },
        {
          "name": "checkHyperlink",
          "link": { "url": "^https?://", "attributes": { "data-check": true }, "excludes": "^\\s*$" },
          "captures": ["url"],
          "actions": ["checkLink"]
        },
        {
          "name": "checkHostedImage",
          "image": { "src": "^https?://", "attributes": { "class": "(^|\\s)hosted(\\s|$)" }, "precededBy": "(?:^|>)\\s*$", "excludes": "^\\s*$" },
          "captures": ["src"],
          "actions": ["checkLink"]
        },
        {
          "name": "clickUiLabel",
          "element": { "tag": ["span", "ph"], "attributes": { "class": "(^|\\s)ui(\\s|$)" }, "precededBy": "\\b[Cc]lick\\s+$" },
          "actions": ["click"]
        },
        {
          "name": "waitComment",
          "comment": { "excludes": "\\bTODO\\b" },
          "regex": "^\\s*wait (\\d+)\\s*$",
          "actions": ["wait"]
        },
        {
          "name": "findEcho",
          "text": {},
          "regex": "\\bthe page shows (.+?) below the field",
          "actions": [{ "find": { "elementText": "$1", "timeout": 5000 } }]
        }
      ]
    },
    {
      "extends": "dita",
      "markup": [
        {
          "name": "checkHostedImage",
          "image": { "src": "^https?://", "attributes": { "class": "(^|\\s)hosted(\\s|$)" }, "precededBy": "(?:^|>)\\s*$", "excludes": "^\\s*$" },
          "captures": ["src"],
          "actions": ["checkLink"]
        },
        {
          "name": "clickUiLabel",
          "element": { "tag": ["span", "ph"], "attributes": { "class": "(^|\\s)ui(\\s|$)" }, "precededBy": "\\b[Cc]lick\\s+$" },
          "actions": ["click"]
        },
        {
          "name": "waitComment",
          "comment": { "excludes": "\\bTODO\\b" },
          "regex": "^\\s*wait (\\d+)\\s*$",
          "actions": ["wait"]
        },
        {
          "name": "findEcho",
          "text": {},
          "regex": "\\bthe page shows (.+?) below the field",
          "actions": [{ "find": { "elementText": "$1", "timeout": 5000 } }]
        }
      ]
    },
    "markdown",
    "asciidoc",
    "rst"
  ]
}
