<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="nav-search-icons">
  <title>Search from the toolbar</title>
  <taskbody>
    <data name="doc-detective" value='test {"testId":"nav-search-icons","detectSteps":false}'/>
    <steps>
      <step><cmd>Go to <xref href="http://localhost:8092/find-image.html" scope="external" format="html">the toolbar page</xref>.</cmd>
        <info><data name="doc-detective" value='step {"goTo":"http://localhost:8092/find-image.html"}'/></info></step>
      <step><cmd>Click the magnifying-glass icon next to the search box.</cmd>
        <info><data name="doc-detective" value='step {"click":{"elementImage":"search.svg"}}'/></info></step>
      <step><cmd>Type "doc detective" and press Enter.</cmd>
        <info><data name="doc-detective" value='step {"type":["doc detective","$ENTER$"]}'/></info></step>
      <step><cmd>Check that the status bar shows <b>doc detective</b>.</cmd>
        <info><data name="doc-detective" value='step {"find":{"selector":"#echo","elementText":"doc detective"}}'/></info></step>
      <step><cmd>Type "-docs" at the end of the search box.</cmd>
        <info><data name="doc-detective" value='step {"type":{"keys":"-docs","selector":"#query","inputDelay":100}}'/></info></step>
      <step><cmd>Check that the status bar shows <b>doc detective-docs</b>.</cmd>
        <info><data name="doc-detective" value='step {"find":{"selector":"#echo","elementText":"doc detective-docs"}}'/></info></step>
      <step><cmd>Right-click the save icon and hold the button for half a second.</cmd>
        <info><data name="doc-detective" value='step {"find":{"elementImage":{"path":"save.svg","threshold":0.95},"click":{"button":"right","duration":500}}}'/></info></step>
      <step><cmd>Check that the status bar records the right-click.</cmd>
        <info><data name="doc-detective" value='step {"find":{"selector":"#log","elementText":"/^click button=2/"}}'/></info></step>
    </steps>
    <data name="doc-detective" value="test end"/>
  </taskbody>
</task>
