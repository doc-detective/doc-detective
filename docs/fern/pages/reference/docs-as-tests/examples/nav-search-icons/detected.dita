<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="nav-search-icons">
  <title>Search from the toolbar</title>
  <taskbody>
    <data name="doc-detective" value='test {"testId":"nav-search-icons","detectSteps":true}'/>
    <steps>
      <step><cmd>Go to <xref href="http://localhost:8092/find-image.html" scope="external" format="html">the toolbar page</xref>.</cmd>
        <info><data name="doc-detective" value='step {"goTo":{"url":"http://localhost:8092/find-image.html","waitUntil":{"find":{"elementImage":{"base64":"","threshold":0.9}}}}}'/></info></step>
      <step><cmd>Click the magnifying-glass icon next to the search box.</cmd>
        <info><data name="doc-detective" value='step {"click":{"elementImage":{"path":"search.svg","color":"#444444"},"elementId":"search-icon"}}'/></info></step>
      <step><cmd>Type "doc detective" and press Enter.</cmd></step>
      <step><cmd>Check that the status bar shows <b>doc detective</b>.</cmd></step>
      <step><cmd>Type "-docs" at the end of the search box.</cmd></step>
      <step><cmd>Check that the status bar shows <b>doc detective-docs</b>.</cmd></step>
      <step><cmd>Right-click the save icon and hold the button for half a second.</cmd>
        <info><data name="doc-detective" value='step {"find":{"elementImage":"save.svg","click":{"button":"right","duration":500}}}'/></info></step>
      <step><cmd>Check that the status bar records the right-click.</cmd></step>
    </steps>
    <data name="doc-detective" value="test end"/>
  </taskbody>
</task>
