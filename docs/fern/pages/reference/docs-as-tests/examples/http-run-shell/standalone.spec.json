{
  "$schema": "https://raw.githubusercontent.com/doc-detective/doc-detective/main/src/common/dist/schemas/spec_v3.schema.json",
  "tests": [
    {
      "testId": "http-run-shell",
      "steps": [
        {
          "runShell": {
            "command": "node",
            "args": [
              "--version"
            ],
            "stdio": "/^v\\d+\\./"
          }
        },
        {
          "runShell": "node -e \"console.log('ready')\""
        },
        {
          "runShell": {
            "command": "node -e \"process.exit(1)\"",
            "shell": "bash",
            "exitCodes": [
              1
            ],
            "timeout": 10000
          }
        },
        {
          "runShell": {
            "command": "node -e \"console.log(require('path').basename(process.cwd()))\"",
            "workingDirectory": ".",
            "stdio": "http-run-shell",
            "path": "folder-name.txt",
            "maxVariation": 0.1,
            "overwrite": "aboveVariation"
          }
        },
        {
          "runShell": {
            "command": "node -e \"console.log('Preview ready'); setInterval(() => {}, 1000)\"",
            "background": {
              "name": "http-shell-preview",
              "waitUntil": {
                "stdio": "Preview ready",
                "delayMs": 250
              }
            },
            "timeout": 15000
          }
        },
        {
          "closeSurface": "http-shell-preview"
        }
      ]
    }
  ]
}
