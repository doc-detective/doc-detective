<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="capture-annotate">
  <title>Point out the controls on a toolbar</title>
  <taskbody>
    <data name="doc-detective" value='test {"testId":"capture-annotate","detectSteps":true,"autoScreenshot":false,"annotationDefaults":{"fontSize":14,"callout":{"background":"#0F172A","color":"#FDE047"},"transition":{"enter":"fade","exit":"fade","durationMs":250}}}'/>
    <steps>
      <step><cmd>Go to <xref href="http://localhost:8092/find-image.html" scope="external" format="html">the toolbar page</xref>.</cmd>
        <info><data name="doc-detective" value='step {"goTo":"http://localhost:8092/find-image.html"}'/></info></step>
      <step><cmd>Find the save button, marked 1, and the green check icon, outlined.</cmd>
        <info><data name="doc-detective" value='step {"annotate":{"add":[{"id":"save-badge","badge":"#save","label":"1"},{"id":"check-outline","outline":{"elementImage":{"path":"check-icon.svg","threshold":0.9},"timeout":10000},"track":true,"transition":{"enter":"draw","durationMs":300}},{"id":"hint","callout":{"elementId":"save"},"label":"Saves your work","position":"bottom","transition":{"enter":"fade","exit":"fade","durationMs":200}},{"id":"banner","text":{"position":"top-right"},"label":"Sample toolbar","duration":3000}]}}'/></info></step>
      <step><cmd>The status line at the top is hidden, because it changes on every visit.</cmd>
        <info><data name="doc-detective" value='step {"annotate":{"add":[{"id":"redact","blur":{"selector":"#status span"},"all":true,"transition":{"enter":"none"}}]}}'/></info></step>
      <step><cmd>Compare your toolbar with the screenshot.</cmd>
        <info><data name="doc-detective" value='step {"screenshot":{"path":"capture-toolbar.png","directory":".dd-output","overwrite":"true"}}'/></info></step>
      <step><cmd>Next, find the check icon, now marked 2.</cmd>
        <info><data name="doc-detective" value='step {"annotate":{"update":[{"id":"save-badge","badge":"#check","label":"2"}]}}'/>
          <data name="doc-detective" value='step {"annotate":{"clear":["hint"]}}'/></info></step>
      <step><cmd>That's every control on the toolbar.</cmd>
        <info><data name="doc-detective" value='step {"annotate":{"clear":true}}'/></info></step>
    </steps>
    <data name="doc-detective" value="test end"/>
  </taskbody>
</task>
