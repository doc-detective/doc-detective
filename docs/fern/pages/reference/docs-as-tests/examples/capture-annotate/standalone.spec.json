{
  "$schema": "https://raw.githubusercontent.com/doc-detective/doc-detective/main/src/common/dist/schemas/spec_v3.schema.json",
  "tests": [
    {
      "testId": "capture-annotate",
      "autoScreenshot": false,
      "annotationDefaults": {
        "fontSize": 14,
        "callout": {
          "background": "#0F172A",
          "color": "#FDE047"
        },
        "transition": {
          "enter": "fade",
          "exit": "fade",
          "durationMs": 250
        }
      },
      "steps": [
        {
          "goTo": "http://localhost:8092/find-image.html"
        },
        {
          "annotate": {
            "add": [
              {
                "id": "save-badge",
                "badge": "#save",
                "label": "1"
              },
              {
                "id": "check-outline",
                "outline": {
                  "elementImage": {
                    "path": "check-icon.svg",
                    "threshold": 0.9
                  },
                  "timeout": 10000
                },
                "track": true,
                "transition": {
                  "enter": "draw",
                  "durationMs": 300
                }
              },
              {
                "id": "hint",
                "callout": {
                  "elementId": "save"
                },
                "label": "Saves your work",
                "position": "bottom",
                "transition": {
                  "enter": "fade",
                  "exit": "fade",
                  "durationMs": 200
                }
              },
              {
                "id": "banner",
                "text": {
                  "position": "top-right"
                },
                "label": "Sample toolbar",
                "duration": 3000
              }
            ]
          }
        },
        {
          "annotate": {
            "add": [
              {
                "id": "redact",
                "blur": {
                  "selector": "#status span"
                },
                "all": true,
                "transition": {
                  "enter": "none"
                }
              }
            ]
          }
        },
        {
          "screenshot": {
            "path": "capture-toolbar.png",
            "directory": ".dd-output",
            "overwrite": "true"
          }
        },
        {
          "annotate": {
            "update": [
              {
                "id": "save-badge",
                "badge": "#check",
                "label": "2"
              }
            ]
          }
        },
        {
          "annotate": {
            "clear": [
              "hint"
            ]
          }
        },
        {
          "annotate": {
            "clear": true
          }
        }
      ]
    }
  ]
}
