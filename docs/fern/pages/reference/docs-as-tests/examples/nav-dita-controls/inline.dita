<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="nav-dita-controls">
  <title>Enter text in a field</title>
  <taskbody>
    <data name="doc-detective" value='test {"testId":"nav-dita-controls","detectSteps":false}'/>
    <steps>
      <step><cmd>Open <xref href="http://localhost:8092/type-echo.html" scope="external" format="html">the type echo page</xref>.</cmd>
        <info><data name="doc-detective" value='step {"goTo":"http://localhost:8092/type-echo.html"}'/></info></step>
      <step><cmd>Check that the page title reads <wintitle>Type Echo Test Page</wintitle>.</cmd>
        <info><data name="doc-detective" value='step {"find":"Type Echo Test Page"}'/></info></step>
      <step><cmd>Click the <uicontrol>Type here:</uicontrol> label.</cmd>
        <info><data name="doc-detective" value='step {"click":"Type here:"}'/></info></step>
      <step><cmd>Type "Hello, DITA".</cmd>
        <info><data name="doc-detective" value='step {"type":"Hello, DITA"}'/></info></step>
      <step><cmd>Check that the page shows <b>Hello, DITA</b> below the field.</cmd>
        <info><data name="doc-detective" value='step {"find":"Hello, DITA"}'/></info></step>
    </steps>
  </taskbody>
  <related-links>
    <link href="http://localhost:8092/index.html" scope="external" format="html"><linktext>Test server home</linktext></link>
  </related-links>
</task>
