{
  "detectSteps": true,
  "resolveIncludes": false,
  "autoScreenshot": false,
  "autoRecord": false,
  "beforeAll": "../../../../../../test-setup/start-server.spec.json",
  "afterAll": "../../../../../../test-setup/stop-server.spec.json",
  "telemetry": {
    "send": false
  },
  "fileTypes": [
    {
      "name": "markdown-ui",
      "extends": "markdown",
      "extensions": ["md", "mdx"],
      "inlineStatements": {
        "in": [{ "comment": {}, "regex": "^dd:\\s*([\\s\\S]*)$" }]
      },
      "markup": [
        {
          "name": "goToUrl",
          "link": { "url": "^https?://", "precededBy": "\\b[Gg]o to(?: the)?\\s+$" },
          "captures": ["url", "text"],
          "actions": ["goTo", { "find": "$2" }]
        },
        {
          "name": "findOnscreenText",
          "strong": { "excludes": "^(?:Note|Tip):?$" },
          "actions": ["find"]
        },
        {
          "name": "typeKeyboardInput",
          "element": { "tag": ["kbd"], "precededBy": "\\b[Ee]nter\\s+$" },
          "captures": ["content"],
          "actions": ["type"]
        },
        {
          "name": "waitForUpdate",
          "emphasis": { "precededBy": "\\b[Ww]ait\\s+$" },
          "regex": "^(\\d+) ms$",
          "actions": ["wait"]
        }
      ]
    },
    "asciidoc",
    "html",
    "dita",
    "rst"
  ]
}
