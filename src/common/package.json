{
  "name": "doc-detective-common",
  "version": "4.40.6",
  "description": "Shared components for Doc Detective projects.",
  "type": "module",
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "generate:types": "node scripts/generateTypes.cjs",
    "dereferenceSchemas": "node ./src/schemas/dereferenceSchemas.cjs",
    "clean": "node -e \"require('fs').rmSync('dist', {recursive: true, force: true})\"",
    "compile": "npm run clean && tsc && node scripts/generateValidators.js && node scripts/createCjsWrapper.js",
    "build": "npm run dereferenceSchemas && npm run generate:types && npm run compile",
    "build:ci": "npm run dereferenceSchemas && npm run compile",
    "test": "mocha",
    "test:coverage": "c8 mocha",
    "test:coverage:html": "c8 --reporter=html mocha",
    "test:coverage:check": "c8 check-coverage",
    "test:coverage:ratchet": "node ../../scripts/check-coverage-ratchet.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doc-detective/doc-detective.git"
  },
  "author": "Manny Silva",
  "license": "AGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/doc-detective/doc-detective/issues"
  },
  "homepage": "https://github.com/doc-detective/doc-detective/tree/main/src/common#readme",
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "^16.0.3",
    "@types/node": "^26.6.3",
    "c8": "^12.0.0",
    "esbuild": "^0.28.2",
    "chai": "^6.3.0",
    "json-schema-to-typescript": "^16.0.0",
    "mocha": "^12.0.3",
    "sinon": "^22.1.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-errors": "^3.0.0",
    "ajv-formats": "^3.0.1",
    "ajv-keywords": "^5.1.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-mdx": "^3.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-mdxjs": "^3.0.0",
    "parse5": "^8.0.1",
    "yaml": "^2.9.1"
  }
}
