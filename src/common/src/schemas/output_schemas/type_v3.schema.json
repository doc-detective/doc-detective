    "d77c392f5d4d2": {
      "type": "number",
      "description": "Delay in milliseconds between each key press during a recording, and between each keystroke sent to a process surface. Not applied on app surfaces in this phase — the native driver types the value atomically.",
      "default": 100
    },
    "dc025ba78e658": {
      "title": "Surface (by name)",
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "transform": [
        "trim"
      ],
      "description": "Name of the surface. A browser engine keyword (chrome|firefox|safari|webkit|edge) targets that browser; any other string names a background process. To target a browser window or tab, use the object form ({ \"browser\": …, \"window\": …, \"tab\": … }) — a plain string is never a window/tab name."
    },
    "d82ef7f351e0d": {
      "type": "string",
      "minLength": 1,
