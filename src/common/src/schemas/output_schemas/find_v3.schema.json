{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "find",
  "description": "Find an element based on display text or a selector, then optionally interact with it.",
  "anyOf": [
    {
      "$ref": "#/x_dd_defs/d1a61ca443b52"
    },
    {
      "$ref": "#/x_dd_defs/de056148477ca"
    }
  ],
  "components": {
    "schemas": {
      "string": {
        "$ref": "#/x_dd_defs/d1a61ca443b52"
      },
      "object": {
        "$ref": "#/x_dd_defs/de056148477ca"
      }
    }
  },
  "examples": [
    "Find me!",
    {
      "selector": "[title=Search]"
    },
    {
      "selector": "[title=Search]",
      "timeout": 10000,
      "elementText": "Search",
      "moveTo": true,
      "click": true,
      "type": "shorthair cat"
    },
    {
      "selector": "[title=Search]",
      "click": {
        "button": "right"
      }
    },
    {
      "selector": "[title=Search]",
      "timeout": 10000,
      "elementText": "Search",
      "moveTo": true,
      "click": true,
      "type": {
        "keys": [
          "shorthair cat"
        ],
        "inputDelay": 100
      }
    },
    {
      "elementId": "/^user-[0-9]+$/",
      "elementClass": [
        "admin",
        "/^level-[1-5]$/"
      ],
      "elementAttribute": {
        "data-active": true,
        "data-score": "/^[0-9]+$/"
      },
      "timeout": 8000,
      "moveTo": false
    }
  ],
  "x_dd_defs": {
    "d1a61ca443b52": {
      "title": "Find element (simple)",
      "type": "string",
      "description": "Identifier for the element to find. Can be a selector, element text, ARIA name, ID, or test ID."
    },
    "d81d8f452f557": {
      "title": "Surface (by browser engine)",
      "type": "string",
      "enum": [
        "chrome",
        "firefox",
        "safari",
        "webkit",
        "edge"
      ],
      "transform": [
        "trim"
      ],
      "description": "Browser engine keyword. Targets that browser. Steps that can only ever act on a browser (not a background process) restrict the bare-string form to this enum, so a process name here is rejected at validation time instead of failing at runtime."
    },
    "d23078c31e9af": {
      "type": "string",
      "enum": [
        "chrome",
        "firefox",
        "safari",
        "webkit",
        "edge"
      ],
      "description": "Browser engine. Selects the browser surface with that engine (or the one named by `name`). A goTo step opens the browser if it isn't open yet — you can also open one explicitly with `startSurface`; other steps require it to already be open."
    },
    "d602d0d67985b": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "transform": [
        "trim"
      ],
      "description": "Name of the browser surface. Defaults to the engine name (the context's default browser registers under its engine). Assign distinct names to drive multiple browsers at once, including several of the same engine."
    },
    "d34d60ebb0a88": {
      "title": "By index",
      "type": "integer",
      "description": "Index in creation order. Negative counts from the end; `-1` is the newest."
    },
    "dcef07241c15a": {
      "title": "By name",
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "transform": [
        "trim"
      ],
      "description": "Name assigned when the window/tab was opened (goTo `newTab`/`newWindow`). The integer branch is listed first because Ajv validates with coerceTypes — string-first would coerce integer indexes into name strings."
    },
    "db83479a87432": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "transform": [
        "trim"
      ],
      "description": "Name assigned when the window/tab was opened."
    },
