          "browser": "chrome",
          "window": "admin",
          "tab": -1
        },
        {
          "browser": "firefox",
          "tab": {
            "title": "/Checkout/"
          }
        },
        {
          "browser": "chrome",
          "name": "shopper"
        },
        {
          "app": "notepad"
        },
        {
          "app": "notepad",
          "window": {
